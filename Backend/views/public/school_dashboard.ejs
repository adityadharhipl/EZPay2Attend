<%- include('../layout/head', { title: school.name + ' Dashboard' }) %>
<style>
    body {
        background-color: var(--bg-base);
    }
    .school-dashboard-container {
        width: 100%;
        max-width: 100%;
        padding: 4rem 5%;
    }
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 1.5rem;
    }
    @media (max-width: 768px) {
        .metrics-grid {
            grid-template-columns: 1fr !important;
        }
        .school-dashboard-container {
            padding: 2rem 1rem;
        }
    }
    .school-header {
        margin-bottom: 3rem;
        text-align: center;
    }
    .school-header h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.5rem;
    }
    .school-header p {
        color: var(--text-secondary);
        font-size: 1.1rem;
    }
    .event-progress {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
        margin-top: 0.5rem;
        overflow: hidden;
    }
    .event-progress-fill {
        height: 100%;
        background: var(--primary);
        border-radius: 3px;
    }
    .event-progress-full {
        background: var(--danger) !important;
    }
</style>

<div class="school-dashboard-container">
    <div class="school-header">
        <h1><%= school.name %></h1>
        <p><i class="fa-solid fa-shield-halved"></i> Secure Read-only Event Dashboard</p>
    </div>

    <% 
        let totalEvents = events.length;
        let totalAttendees = events.reduce((sum, e) => sum + e._count.attendees, 0);
        let totalCapacity = events.reduce((sum, e) => sum + e.capacity, 0);
        let utilization = totalCapacity > 0 ? ((totalAttendees / totalCapacity) * 100).toFixed(1) : 0;
    %>

    <div class="metrics-grid" style="grid-template-columns: repeat(4, 1fr) !important;">
        <div class="metric-card">
            <div class="metric-card-header">
                Total Events <i class="fa-solid fa-calendar-days"></i>
            </div>
            <div class="metric-card-value"><%= totalEvents %></div>
        </div>
        
        <div class="metric-card">
            <div class="metric-card-header">
                Total Attendees <i class="fa-solid fa-users"></i>
            </div>
            <div class="metric-card-value"><%= totalAttendees %></div>
        </div>

        <div class="metric-card">
            <div class="metric-card-header">
                Capacity Utilization <i class="fa-solid fa-percent"></i>
            </div>
            <div class="metric-card-value"><%= utilization %>%</div>
        </div>

        <div class="metric-card">
            <div class="metric-card-header">
                Total Revenue <i class="fa-solid fa-money-bill-wave"></i>
            </div>
            <div class="metric-card-value">$<%= totalSchoolRevenue.toFixed(2) %></div>
        </div>
    </div>

    <div class="dashboard-section" style="margin-top: 2rem;">
        <h3><i class="fa-solid fa-list-check"></i> Live Event Reports</h3>
        
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Event Title</th>
                        <th>Date</th>
                        <th>Capacity Filled</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (paginatedEvents.length === 0) { %>
                        <tr><td colspan="5" style="text-align: center; color: var(--text-secondary); padding: 3rem;">No active events found for your school.</td></tr>
                    <% } else { %>
                        <% paginatedEvents.forEach((event, index) => { %>
                            <tr>
                                <td><%= (page - 1) * 10 + index + 1 %></td>
                                <td><strong><%= event.title %></strong></td>
                                <td><%= event.date ? new Date(event.date).toLocaleDateString(undefined, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) : 'TBD' %></td>
                                <td>
                                    <div style="font-weight: 500;"><%= event._count.attendees %> / <%= event.capacity %></div>
                                    <% const pct = Math.min(100, (event._count.attendees / event.capacity) * 100); %>
                                    <div class="event-progress">
                                        <div class="event-progress-fill <%= pct >= 100 ? 'event-progress-full' : '' %>" data-width="<%= pct %>"></div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge <%= event.status === 'OPEN' ? 'success' : (event.status === 'CLOSED' ? 'warning' : 'info') %>">
                                        <%= event.status %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
        
        <% if (totalPages > 1) { %>
            <div style="display: flex; justify-content: flex-end; align-items: center; padding: 1.5rem 0 0 0; gap: 0.5rem;">
                <% if (page > 1) { %>
                    <a href="?page=<%= page - 1 %>" class="btn" style="width: auto; padding: 0.5rem 1rem; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--text-primary);"><i class="fa-solid fa-chevron-left"></i> Prev</a>
                <% } %>
                
                <span style="padding: 0.5rem 1rem; color: var(--text-secondary); font-size: 0.95rem;">Page <%= page %> of <%= totalPages %></span>
                
                <% if (page < totalPages) { %>
                    <a href="?page=<%= page + 1 %>" class="btn" style="width: auto; padding: 0.5rem 1rem; background: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--text-primary);">Next <i class="fa-solid fa-chevron-right"></i></a>
                <% } %>
            </div>
        <% } %>
    </div>
</div>
<script>
    document.querySelectorAll('.event-progress-fill').forEach(el => {
        if(el.dataset.width) {
            el.style.width = el.dataset.width + '%';
        }
    });
</script>
</body>
</html>
