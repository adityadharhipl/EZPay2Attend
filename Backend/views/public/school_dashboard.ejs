<%- include('../layout/head', { title: school.name + ' Dashboard' }) %>
<style>
    body { background: var(--bg-base); margin: 0; padding: 2rem; color: #fff; }
    .school-header { margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem; }
    .school-header h1 { margin: 0; color: var(--primary); }
    .school-header p { color: var(--text-secondary); margin-top: 0.5rem; }
    
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
    .stat-card { background: var(--surface-light); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--border-color); }
    .stat-card h3 { margin: 0 0 0.5rem 0; font-size: 0.9rem; color: var(--text-secondary); text-transform: uppercase; }
    .stat-card .value { font-size: 2rem; font-weight: 700; color: #fff; }
    
    .events-list { margin-top: 2rem; }
    .event-card { background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.5rem; margin-bottom: 1rem; }
    .event-card h4 { margin: 0 0 1rem 0; color: var(--primary); font-size: 1.2rem; }
    
    .metrics-row { display: flex; gap: 2rem; }
    .metric { flex: 1; }
    .metric-label { font-size: 0.85rem; color: var(--text-secondary); }
    .metric-val { font-size: 1.2rem; font-weight: 600; }
    .status-open { color: #28a745; }
    .status-other { color: #ffc107; }
</style>

<div class="school-header">
    <h1><%= school.name %></h1>
    <p>Read-only Event Dashboard</p>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <h3>Total Events</h3>
        <div class="value"><%= events.length %></div>
    </div>
    <div class="stat-card">
        <h3>Total Attendees</h3>
        <div class="value"><%= events.reduce((sum, e) => sum + e._count.attendees, 0) %></div>
    </div>
</div>

<div class="events-list">
    <h3 style="margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">Your Events</h3>
    <% if (events.length === 0) { %>
        <p style="color: var(--text-secondary);">No events found for this school.</p>
    <% } else { %>
        <% events.forEach(event => { %>
            <div class="event-card">
                <h4><%= event.title %></h4>
                <div class="metrics-row">
                    <div class="metric">
                        <div class="metric-label">Status</div>
                        <div class="metric-val <%= event.status === 'OPEN' ? 'status-open' : 'status-other' %>"><%= event.status %></div>
                    </div>
                    <div class="metric">
                        <div class="metric-label">Capacity Filled</div>
                        <div class="metric-val"><%= event._count.attendees %> / <%= event.capacity %></div>
                    </div>
                    <div class="metric">
                        <div class="metric-label">Date</div>
                        <div class="metric-val"><%= event.date ? new Date(event.date).toLocaleDateString() : 'TBD' %></div>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } %>
</div>
</body>
</html>
