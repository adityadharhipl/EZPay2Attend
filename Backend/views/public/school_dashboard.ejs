<%- include('../layout/head', { title: school.name + ' Dashboard' }) %>
    <style>
        body {
            background-color: var(--bg-base);
        }

        .school-dashboard-container {
            width: 100%;
            max-width: 100%;
            padding: 4rem 5%;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr) !important;
            gap: 1.5rem;
        }

        @media (max-width: 768px) {
            .metrics-grid {
                grid-template-columns: 1fr !important;
            }

            .school-dashboard-container {
                padding: 2rem 1rem;
            }
        }

        .school-header {
            margin-bottom: 3rem;
            text-align: center;
        }

        .school-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 0.5rem;
        }

        .school-header p {
            color: var(--text-secondary);
            font-size: 1.1rem;
        }

        .event-progress {
            width: 100%;
            height: 6px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
            margin-top: 0.5rem;
            overflow: hidden;
        }

        .event-progress-fill {
            height: 100%;
            background: var(--primary);
            border-radius: 3px;
        }

        .event-progress-full {
            background: var(--danger) !important;
        }

        .accordion-row {
            display: none;
            background: rgba(255, 255, 255, 0.02);
        }

        .accordion-row.show {
            display: table-row;
        }

        .main-row {
            cursor: pointer;
            transition: background 0.2s;
        }

        .main-row:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .chevron {
            transition: transform 0.3s;
        }

        .chevron.rotate {
            transform: rotate(180deg);
        }

        .inner-table {
            width: 100%;
            margin-top: 1rem;
            background: var(--bg-base);
            border-radius: 8px;
            overflow: hidden;
        }

        .inner-table th {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-secondary);
            font-size: 0.8rem;
            padding: 0.5rem 1rem;
        }

        .inner-table td {
            padding: 0.5rem 1rem;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.9rem;
        }
    </style>

    <div
        style="background: var(--bg-surface); border-bottom: 1px solid var(--border); padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; width: 100%;">
        <div>
            <h2 style="margin: 0; color: #fff;">EZPay2Attend</h2>
            <div style="font-size: 0.85rem; color: var(--text-secondary);">School Committee Shared View</div>
        </div>
        <div style="text-align: right;">
            <div style="font-weight: 600; color: #fff;">
                <%= school.name %>
            </div>
            <div style="font-size: 0.85rem; color: var(--text-secondary);">Read-Only Access</div>
        </div>
    </div>

    <div class="school-dashboard-container" style="padding-top: 2rem;">

        <% let totalEvents=events.length; let totalAttendees=events.reduce((sum, e)=> sum + e._count.attendees, 0);
            let totalCapacity = events.reduce((sum, e) => sum + e.capacity, 0);
            let utilization = totalCapacity > 0 ? ((totalAttendees / totalCapacity) * 100).toFixed(1) : 0;
            %>

            <div class="metrics-grid" style="grid-template-columns: repeat(4, 1fr) !important;">
                <div class="metric-card">
                    <div class="metric-card-header">
                        Total Events <i class="fa-solid fa-calendar-days"></i>
                    </div>
                    <div class="metric-card-value">
                        <%= totalEvents %>
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-card-header">
                        Total Attendees <i class="fa-solid fa-users"></i>
                    </div>
                    <div class="metric-card-value">
                        <%= totalAttendees %>
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-card-header">
                        Capacity Utilization <i class="fa-solid fa-percent"></i>
                    </div>
                    <div class="metric-card-value">
                        <%= utilization %>%
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-card-header">
                        Total Revenue <i class="fa-solid fa-money-bill-wave"></i>
                    </div>
                    <div class="metric-card-value">$<%= totalSchoolRevenue.toFixed(2) %>
                    </div>
                </div>
            </div>

            <div class="dashboard-section" style="margin-top: 2rem;">
                <div class="accordion-header"
                    style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                    <h3 style="margin: 0; white-space: nowrap;"><i class="fa-solid fa-list-check"></i> Live Event Reports</h3>
                    
                    <div style="display: flex; align-items: center; gap: 1rem;">
                        <a href="/school/<%= school.id %>/export" class="btn" 
                            style="background: var(--surface-light); border: 1px solid var(--border-color); color: var(--text-secondary); text-decoration: none; padding: 0.4rem 1rem; display: flex; align-items: center; gap: 0.5rem; white-space: nowrap; font-size: 0.85rem;">
                            <i class="fa-solid fa-file-excel" style="color: #4ade80;"></i> Export Excel
                        </a>
                    </div>
                </div>

                <div class="accordion-content show" id="liveReportsContent" style="display: block; margin-top: 1rem;">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>S.No.</th>
                                    <th>Event Title</th>
                                    <th>Date</th>
                                    <th>Capacity Filled</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (paginatedEvents.length===0) { %>
                                    <tr>
                                        <td colspan="5"
                                            style="text-align: center; color: var(--text-secondary); padding: 3rem;">No
                                            active events found for your school.</td>
                                    </tr>
                                    <% } else { %>
                                        <% paginatedEvents.forEach((event, index)=> { %>
                                            <tr class="main-row" onclick="toggleAccordion('<%= index %>')" style="cursor: pointer;">
                                                <td>
                                                    <%= (page - 1) * 10 + index + 1 %>
                                                </td>
                                                <td><strong>
                                                        <%= event.title %>
                                                    </strong></td>
                                                <td>
                                                    <%= event.date ? new Date(event.date).toLocaleDateString(undefined,
                                                        { weekday: 'short' , year: 'numeric' , month: 'short' ,
                                                        day: 'numeric' }) : 'TBD' %>
                                                </td>
                                                <td>
                                                    <div style="font-weight: 500;">
                                                        <%= event._count.attendees %> / <%= event.capacity %>
                                                    </div>
                                                    <% const pct=Math.min(100, (event._count.attendees / event.capacity)
                                                        * 100); %>
                                                        <div class="event-progress">
                                                            <div class="event-progress-fill <%= pct >= 100 ? 'event-progress-full' : '' %>"
                                                                data-width="<%= pct %>"></div>
                                                        </div>
                                                </td>
                                                <td>
                                                    <div
                                                        style="display: flex; align-items: center; justify-content: space-between;">
                                                        <span
                                                            class="badge <%= event.status === 'OPEN' ? 'success' : (event.status === 'CLOSED' ? 'warning' : 'info') %>">
                                                            <%= event.status %>
                                                        </span>
                                                        <i class="fa-solid fa-chevron-down chevron" id="chevron-<%= index %>" style="color: var(--text-secondary); transition: transform 0.3s;"></i>
                                                    </div>
                                                </td>
                                            </tr>
                                            <!-- Accordion content for Attendees -->
                                            <tr class="accordion-row" id="accordion-<%= index %>">
                                                <td colspan="5" style="padding: 0; border: none; background: rgba(0,0,0,0.15);">
                                                    <div style="padding: 1.5rem;">
                                                        <h4 style="margin-top: 0; color: #fff; margin-bottom: 1rem;"><i class="fa-solid fa-users"></i> Registered Attendees & Payments</h4>
                                                        <% if(event.attendees && event.attendees.length > 0) { %>
                                                            <div class="table-responsive" style="background: rgba(255,255,255,0.02); border-radius: 8px;">
                                                                <table class="table inner-table" style="margin: 0; background: transparent;">
                                                                    <thead>
                                                                        <tr>
                                                                            <th style="background: rgba(255,255,255,0.05); width: 60px;">S.No.</th>
                                                                            <th style="background: rgba(255,255,255,0.05);">Name</th>
                                                                            <th style="background: rgba(255,255,255,0.05);">Date</th>
                                                                            <th style="background: rgba(255,255,255,0.05);">Reg Status</th>
                                                                            <th style="background: rgba(255,255,255,0.05);">Payment Status</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        <% event.attendees.forEach((a, attendeeIndex) => { 
                                                                            let totalPaid = 0;
                                                                            a.payments.forEach(p => {
                                                                                if(p.status === 'SUCCESS' && p.type !== 'REFUND') totalPaid += p.amount;
                                                                            });
                                                                            let balanceDue = event.costPerAttendee - totalPaid;
                                                                            if(balanceDue < 0) balanceDue = 0;
                                                                        %>
                                                                        <tr>
                                                                            <td><%= attendeeIndex + 1 %></td>
                                                                            <td><%= a.fullName %></td>
                                                                            <td><%= new Date(a.createdAt).toLocaleDateString() %></td>
                                                                            <td>
                                                                                <span class="badge status-<%= a.status === 'REFUND_REQUESTED' ? 'refunded' : a.status.toLowerCase() %>" style="font-size: 0.75rem;">
                                                                                    <%= a.status === 'REFUND_REQUESTED' ? 'REFUND' : a.status.replace('_', ' ') %>
                                                                                </span>
                                                                            </td>
                                                                            <td>
                                                                                <% if(balanceDue > 0) { %>
                                                                                    <span style="color: var(--danger); font-weight: 500;">Due: $<%= balanceDue.toFixed(2) %></span>
                                                                                <% } else { %>
                                                                                    <span style="color: var(--success); font-weight: 500;">Paid in Full</span>
                                                                                <% } %>
                                                                                <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.2rem;">
                                                                                    Total Cost: $<%= event.costPerAttendee.toFixed(2) %>
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                        <% }) %>
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        <% } else { %>
                                                            <div style="color: var(--text-secondary); font-size: 0.9rem;">No attendees registered yet.</div>
                                                        <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <% if (totalPages> 1) { %>
                        <div
                            style="display: flex; justify-content: flex-end; align-items: center; padding: 1.5rem 0 0 0; gap: 0.5rem;">
                            <% if (page> 1) { %>
                                <a href="?page=<%= page - 1 %>" class="btn"
                                    style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">Previous</a>
                                <% } %>

                                    <% for(let i=1; i<=totalPages; i++) { %>
                                        <a href="?page=<%= i %>" class="btn <%= i == page ? 'btn-primary' : '' %>"
                                            style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
                                            <%= i %>
                                        </a>
                                        <% } %>

                                            <% if (page < totalPages) { %>
                                                <a href="?page=<%= page + 1 %>" class="btn"
                                                    style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">Next</a>
                                                <% } %>
                        </div>
                        <% } %>
                </div> <!-- End of accordion-content -->
            </div>
    </div>
    <script>
        async function sendReminder(attendeeId, btnElement) {
            if (!confirm('Send a payment reminder email to this attendee?')) return;

            const originalHtml = btnElement.innerHTML;
            btnElement.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
            btnElement.disabled = true;

            try {
                const token = localStorage.getItem('ezpay_token');
                const res = await fetch(`/api/attendees/${attendeeId}/reminders/balance`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                const data = await res.json();
                if (data.success) {
                    alert('Reminder sent successfully!');
                    btnElement.innerHTML = '<i class="fa-solid fa-check" style="color: var(--success);"></i>';
                } else {
                    alert('Failed: ' + data.message);
                    btnElement.innerHTML = originalHtml;
                    btnElement.disabled = false;
                }
            } catch (err) {
                alert('Error sending reminder');
                btnElement.innerHTML = originalHtml;
                btnElement.disabled = false;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const fills = document.querySelectorAll('.event-progress-fill');
            fills.forEach(fill => {
                const width = fill.getAttribute('data-width');
                setTimeout(() => {
                    fill.style.width = width + '%';
                }, 100);
            });
        });

        function toggleAccordion(index) {
            const row = document.getElementById('accordion-' + index);
            const chevron = document.getElementById('chevron-' + index);

            row.classList.toggle('show');
            chevron.classList.toggle('rotate');
        }

        function toggleSectionAccordion(id) {
            const content = document.getElementById(id + 'Content');
            const icon = document.getElementById(id + 'Icon');

            if (content.style.display === 'none' || !content.style.display) {
                content.style.display = 'block';
                icon.classList.remove('rotate');
            } else {
                content.style.display = 'none';
                icon.classList.add('rotate');
            }
        }
    </script>
    </body>

    </html>