<%- include('../layout/head', { title: title || 'Schools | EZPay2Attend' }) %>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<style>
    .events-container { padding: 2rem; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .table-dark-custom {
        background: var(--surface-light);
        color: var(--text-primary);
        border-radius: 12px;
        overflow: hidden;
    }
    .table-dark-custom th {
        background: rgba(255,255,255,0.05);
        color: var(--text-secondary);
        font-weight: 500;
        border-bottom: 1px solid var(--border-color);
    }
    .table-dark-custom td { border-bottom: 1px solid var(--border-color); vertical-align: middle; }
    .action-btn { background: transparent; border: none; color: var(--text-secondary); padding: 0.4rem; transition: all 0.2s; border-radius: 6px; }
    .action-btn:hover { background: rgba(255,255,255,0.1); color: var(--primary-color); }
    .action-btn.delete:hover { color: var(--danger); }
    .custom-modal { display: none; position: fixed; z-index: 10000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; }
    .custom-modal.show { display: flex; }
    .custom-modal-content { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); width: 90%; max-width: 600px; padding: 1.5rem; }
    .custom-modal-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 1rem; margin-bottom: 1rem; }
    .custom-modal-footer { display: flex; justify-content: flex-end; gap: 1rem; border-top: 1px solid var(--border); padding-top: 1rem; margin-top: 1.5rem; }
    
    .delete-modal-content { background: #fff; border-radius: 12px; width: 90%; max-width: 400px; padding: 2.5rem 2rem; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .delete-modal-content h3 { color: #1E293B; font-weight: 700; margin-bottom: 0.5rem; }
    .delete-modal-content p { color: #475569; margin-bottom: 2rem; font-size: 0.95rem; }
    .delete-modal-actions { display: flex; justify-content: center; gap: 1rem; }
    .delete-btn-cancel { background: #fff; color: #1E293B; border: 1px solid #CBD5E1; padding: 0.6rem 1.5rem; border-radius: 6px; font-weight: 500; cursor: pointer; }
    .delete-btn-confirm { background: #1E293B; color: #fff; border: none; padding: 0.6rem 1.5rem; border-radius: 6px; font-weight: 500; cursor: pointer; }
    
    .close-btn { background: transparent; border: none; color: var(--text-secondary); font-size: 1.5rem; cursor: pointer; }
    .form-control, .form-select { background: var(--bg-base); border: 1px solid var(--border); color: var(--text-primary); width: 100%; padding: 0.5rem; border-radius: 6px; margin-top: 0.25rem; margin-bottom: 1rem; }
    .row { display: flex; flex-wrap: wrap; margin: -0.5rem; }
    .col-md-12 { width: 100%; padding: 0.5rem; }
    .col-md-6 { width: 50%; padding: 0.5rem; }
    .form-label { color: var(--text-secondary); font-size: 0.9rem; }
    .pagination-container { display: flex; justify-content: flex-end; align-items: center; gap: 0.5rem; margin-top: 1rem; }
    .page-link-btn { background: var(--surface-light); border: 1px solid var(--border-color); color: var(--text-secondary); padding: 0.4rem 0.8rem; border-radius: 6px; text-decoration: none; font-size: 0.9rem; transition: all 0.2s; }
    .page-link-btn:hover { background: rgba(255,255,255,0.1); color: var(--primary-color); }
    .page-link-btn.active { background: var(--primary-color); color: #fff; border-color: var(--primary-color); }
</style>

<div class="dashboard-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-logo">EZPay2Attend</div>
        <nav>
            <a href="/admin" class="nav-link"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
            <a href="/admin/events" class="nav-link"><i class="fa-solid fa-calendar-alt"></i> Events</a>
            <a href="/admin/schools" class="nav-link active"><i class="fa-solid fa-school"></i> Schools</a>
            <a href="/admin/attendees" class="nav-link"><i class="fa-solid fa-users"></i> Attendees</a>
            <a href="/admin/payments" class="nav-link"><i class="fa-solid fa-credit-card"></i> Payments</a>
            <a href="/admin/refunds" class="nav-link"><i class="fa-solid fa-arrow-rotate-left"></i> Refunds</a>
            <a href="javascript:void(0)" onclick="openLogoutModal()" class="nav-link" style="margin-top: 2rem; color: var(--danger);"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Standard Page Header -->
        <div class="page-header" style="margin-bottom: 2rem;">
            <div class="header-left">
                <h3 style="margin: 0; color: #fff;">Schools Management</h3>
            </div>
            
            <div class="header-right">
                <div class="header-icon"><i class="fa-regular fa-bell"></i><div class="badge-dot"></div></div>
                <div class="header-icon"><i class="fa-regular fa-message"></i><div class="badge-dot"></div></div>
                
                <!-- Profile Dropdown -->
                <div class="profile-menu">
                    <div class="profile-icon" onclick="toggleDropdown()" style="border: none; background: transparent; padding: 0;">
                        <div style="text-align: right; margin-right: 0.5rem;">
                            <div style="font-weight: 600; font-size: 0.9rem; color: #fff;"><%= user.name %></div>
                            <div style="font-size: 0.75rem; color: var(--text-secondary);"><%= user.role || 'Admin' %></div>
                        </div>
                        <i class="fa-solid fa-user-circle" style="font-size: 2rem; color: var(--primary);"></i>
                        <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem; margin-left: 0.5rem;"></i>
                    </div>
                    <div class="profile-dropdown" id="profileDropdown">
                        <div class="dropdown-header">
                            <strong><%= user.name %></strong>
                            <p><%= user.email %></p>
                        </div>
                        <div class="dropdown-divider"></div>
                        <a href="/admin/profile" class="dropdown-item"><i class="fa-solid fa-user-pen"></i> Edit Profile</a>
                        <a href="javascript:void(0)" onclick="openLogoutModal()" class="dropdown-item text-danger"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Schools List -->
        <div class="dashboard-section">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <h3 style="margin: 0;"><i class="fa-solid fa-school"></i> All Schools</h3>
                <button class="btn" style="width: auto; padding: 0.5rem 1.5rem;" onclick="openModal()">
                    <i class="fa-solid fa-plus" style="margin-right: 8px;"></i> Create School
                </button>
            </div>
            
            <div class="table-responsive">
                <table id="schoolsTable" class="table table-dark-custom table-hover w-100">
                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>School Name</th>
                            <th>Contact Person</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Total Events</th>
                            <th>Created At</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% schools.forEach((school, index) => { %>
                        <tr>
                            <td><%= (pagination.page - 1) * pagination.limit + index + 1 %></td>
                            <td class="fw-bold"><%= school.name %></td>
                            <td><%= school.contactPerson || 'N/A' %></td>
                            <td><%= school.email || 'N/A' %></td>
                            <td><%= school.phone || 'N/A' %></td>
                            <td><span class="badge" style="background: var(--primary); padding: 5px 10px; border-radius: 20px;"><%= school._count ? school._count.events : 0 %> Events</span></td>
                            <td><%= new Date(school.createdAt).toLocaleDateString() %></td>
                            <td class="text-end">
                                <button class="action-btn" title="Copy Committee Dashboard Link" onclick="copySchoolLink('<%= school.id %>')"><i class="fa-solid fa-link"></i></button>
                                <button class="action-btn" title="Edit" onclick="editSchool('<%= school.id %>')"><i class="fa-solid fa-pen"></i></button>
                                <button class="action-btn delete" title="Delete" data-id="<%= school.id %>" data-name="<%= school.name %>" onclick="deleteSchool(this.dataset.id, this.dataset.name)"><i class="fa-solid fa-trash"></i></button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            
            <% if (pagination && pagination.totalPages > 1) { %>
            <div class="pagination-container">
                <% if (pagination.page > 1) { %>
                    <a href="?page=<%= pagination.page - 1 %>" class="page-link-btn">Previous</a>
                <% } %>
                
                <% for(let i=1; i<=pagination.totalPages; i++) { %>
                    <a href="?page=<%= i %>" class="page-link-btn <%= i === pagination.page ? 'active' : '' %>"><%= i %></a>
                <% } %>
                
                <% if (pagination.page < pagination.totalPages) { %>
                    <a href="?page=<%= pagination.page + 1 %>" class="page-link-btn">Next</a>
                <% } %>
            </div>
            <% } %>
        </div>
    </main>
</div>

<!-- Create/Edit School Modal -->
<div class="custom-modal" id="createSchoolModal">
  <div class="custom-modal-content">
    <div class="custom-modal-header">
      <h3 style="margin: 0; color: var(--text-primary);">Create New School</h3>
      <button type="button" class="close-btn" onclick="closeModal()">&times;</button>
    </div>
    <form id="createSchoolForm">
            <div class="row g-3">
                <div class="col-md-12">
                    <label class="form-label">School Name</label>
                    <input type="text" class="form-control" name="name" required placeholder="e.g. Springfield High">
                </div>
                
                <div class="col-md-6">
                    <label class="form-label">Contact Person</label>
                    <input type="text" class="form-control" name="contactPerson" placeholder="e.g. John Doe">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" name="email" placeholder="e.g. contact@school.edu">
                </div>
                
                <div class="col-md-6">
                    <label class="form-label">Phone</label>
                    <input type="text" class="form-control" name="phone" placeholder="e.g. +1 555-0198">
                </div>
                
                <div class="col-md-12">
                    <label class="form-label">Address</label>
                    <textarea class="form-control" name="address" rows="2" placeholder="Full address..."></textarea>
                </div>
            </div>
            
            <div class="custom-modal-footer">
                <button type="button" class="btn" style="background: transparent; color: var(--text-secondary); width: auto;" onclick="closeModal()">Cancel</button>
                <button type="button" class="btn" style="width: auto;" id="saveSchoolBtn" onclick="saveSchoolData()">Save School</button>
            </div>
        </form>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="custom-modal" id="deleteSchoolModal">
  <div class="delete-modal-content">
    <h3>Confirm Delete</h3>
    <p>Are you sure you want to delete <span id="deleteSchoolName" style="font-weight: 700; color: #1E293B;"></span>?</p>
    <div class="delete-modal-actions">
        <button type="button" class="delete-btn-cancel" onclick="closeDeleteModal()">Cancel</button>
        <button type="button" class="delete-btn-confirm" onclick="confirmDeleteSchool()">Delete</button>
    </div>
  </div>
</div>

<script id="schoolsData" type="application/json">
    <%- JSON.stringify(schools || []) %>
</script>

<script>
    const allSchools = JSON.parse(document.getElementById('schoolsData').textContent);
    let editingSchoolId = null;

    function openModal() {
        editingSchoolId = null;
        document.getElementById('createSchoolForm').reset();
        document.querySelector('.custom-modal-header h3').textContent = 'Create New School';
        document.getElementById('createSchoolModal').classList.add('show');
    }
    
    function editSchool(id) {
        editingSchoolId = id;
        const school = allSchools.find(s => s.id === id);
        if (!school) return;
        
        const form = document.getElementById('createSchoolForm');
        form.reset();
        
        form.name.value = school.name || '';
        form.contactPerson.value = school.contactPerson || '';
        form.email.value = school.email || '';
        form.phone.value = school.phone || '';
        form.address.value = school.address || '';
        
        document.querySelector('.custom-modal-header h3').textContent = 'Edit School';
        document.getElementById('createSchoolModal').classList.add('show');
    }

    function closeModal() {
        document.getElementById('createSchoolModal').classList.remove('show');
        editingSchoolId = null;
    }

    async function saveSchoolData() {
        const form = document.getElementById('createSchoolForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        
        const btn = document.getElementById('saveSchoolBtn');
        btn.disabled = true;
        btn.innerHTML = 'Saving...';
        
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        
        try {
            const url = editingSchoolId ? '/api/schools/' + editingSchoolId : '/api/schools';
            const method = editingSchoolId ? 'PATCH' : 'POST';
            
            const res = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            
            if(result.success) {
                showToast(result.message, 'success');
                setTimeout(() => window.location.reload(), 1500);
            } else {
                showToast(result.message, 'error');
                btn.disabled = false;
                btn.innerHTML = 'Save School';
            }
        } catch (err) {
            showToast('Network error occurred.', 'error');
            btn.disabled = false;
            btn.innerHTML = 'Save School';
        }
    }

    let schoolToDelete = null;

    function deleteSchool(id, name) {
        schoolToDelete = id;
        document.getElementById('deleteSchoolName').textContent = name;
        document.getElementById('deleteSchoolModal').classList.add('show');
    }

    function closeDeleteModal() {
        schoolToDelete = null;
        document.getElementById('deleteSchoolModal').classList.remove('show');
    }

    function copySchoolLink(id) {
        const link = window.location.origin + '/school/' + id + '/dashboard';
        navigator.clipboard.writeText(link).then(() => {
            showToast('School Dashboard link copied to clipboard!', 'success');
        });
    }

    async function confirmDeleteSchool() {
        if(!schoolToDelete) return;
        
        try {
            const res = await fetch('/api/schools/' + schoolToDelete, { method: 'DELETE' });
            const result = await res.json();
            if(result.success) {
                showToast(result.message, 'success');
                setTimeout(() => window.location.reload(), 1500);
            } else {
                showToast('Error: ' + result.message, 'error');
                closeDeleteModal();
            }
        } catch (err) {
            showToast('Network error occurred.', 'error');
            closeDeleteModal();
        }
    }

    function toggleDropdown() {
        document.getElementById("profileDropdown").classList.toggle("show");
    }
    
    window.onclick = function(event) {
        if (!event.target.closest('.profile-menu')) {
            var dropdowns = document.getElementsByClassName("profile-dropdown");
            for (var i = 0; i < dropdowns.length; i++) {
                var openDropdown = dropdowns[i];
                if (openDropdown.classList.contains('show')) {
                    openDropdown.classList.remove('show');
                }
            }
        }
    }
</script>
</body>
</html>
