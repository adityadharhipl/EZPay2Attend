<%- include('../layout/head', { title: title || 'Events | EZPay2Attend' }) %>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <style>
        .events-container {
            padding: 2rem;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .status-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .status-open {
            background: rgba(40, 167, 69, 0.15);
            color: #28a745;
        }

        .status-closed {
            background: rgba(220, 53, 69, 0.15);
            color: #dc3545;
        }

        .status-completed {
            background: rgba(0, 123, 255, 0.15);
            color: #007bff;
        }

        .status-cancelled {
            background: rgba(108, 117, 125, 0.15);
            color: #6c757d;
        }

        .table-dark-custom {
            background: var(--surface-light);
            color: var(--text-primary);
            border-radius: 12px;
            overflow: hidden;
        }

        .table-dark-custom th {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-secondary);
            font-weight: 500;
            border-bottom: 1px solid var(--border-color);
        }

        .table-dark-custom td {
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
        }

        .action-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            padding: 0.4rem;
            transition: all 0.2s;
            border-radius: 6px;
        }

        .action-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--primary-color);
        }

        .action-btn.delete:hover {
            color: var(--danger);
        }

        /* Custom Modal Styling */
        .custom-modal {
            display: none;
            position: fixed;
            z-index: 10000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.6);
            align-items: center;
            justify-content: center;
        }

        .custom-modal.show {
            display: flex;
        }

        .custom-modal-content {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            width: 90%;
            max-width: 700px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 1.5rem;
        }

        .custom-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            padding-bottom: 1rem;
            margin-bottom: 1rem;
        }

        .custom-modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            border-top: 1px solid var(--border);
            padding-top: 1rem;
            margin-top: 1.5rem;
        }

        .delete-modal-content {
            background: var(--bg-surface);
            border-radius: 12px;
            width: 90%;
            max-width: 400px;
            padding: 2.5rem 2rem;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border: 1px solid var(--border);
        }

        .delete-modal-content h3 {
            color: var(--text-primary);
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .delete-modal-content p {
            color: var(--text-secondary);
            margin-bottom: 2rem;
            font-size: 0.95rem;
        }

        .delete-modal-actions {
            display: flex;
            justify-content: center;
            gap: 1rem;
        }

        .delete-btn-cancel {
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid var(--border);
            padding: 0.6rem 1.5rem;
            border-radius: 6px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .delete-btn-cancel:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-primary);
        }

        .delete-btn-confirm {
            background: var(--danger);
            color: #fff;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 6px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .delete-btn-confirm:hover {
            opacity: 0.9;
        }

        .close-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-size: 1.5rem;
            cursor: pointer;
        }

        .form-control,
        .form-select {
            background: var(--bg-base);
            border: 1px solid var(--border);
            color: var(--text-primary);
            width: 100%;
            padding: 0.5rem;
            border-radius: 6px;
            margin-top: 0.25rem;
            margin-bottom: 1rem;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            margin: -0.5rem;
        }

        .col-md-12 {
            width: 100%;
            padding: 0.5rem;
        }

        .col-md-6 {
            width: 50%;
            padding: 0.5rem;
        }

        .col-md-4 {
            width: 33.33%;
            padding: 0.5rem;
        }

        .form-label {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        .pagination-container {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .page-link-btn {
            background: var(--surface-light);
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

        .page-link-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--primary-color);
        }

        .page-link-btn.active {
            background: var(--primary-color);
            color: #fff;
            border-color: var(--primary-color);
        }

        .accordion-row {
            display: none;
            background: rgba(0, 0, 0, 0.2);
        }

        .accordion-row.show {
            display: table-row;
        }

        .chevron {
            transition: transform 0.3s;
            cursor: pointer;
        }

        .inner-table {
            width: 100%;
            border-collapse: collapse;
            margin: 1rem 0;
            background: var(--bg-base);
            border-radius: 8px;
            overflow: hidden;
        }

        .inner-table th,
        .inner-table td {
            padding: 0.8rem 1rem;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }

        .inner-table th {
            background: rgba(255, 255, 255, 0.05);
            font-weight: 500;
            color: var(--text-secondary);
        }
    </style>

    <div class="dashboard-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-logo">EZPay2Attend</div>
            <nav>
                <a href="/admin" class="nav-link"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                <a href="/admin/events" class="nav-link active"><i class="fa-solid fa-calendar-alt"></i> Events</a>
                <a href="/admin/schools" class="nav-link"><i class="fa-solid fa-school"></i> Schools</a>
                <a href="/admin/payments" class="nav-link"><i class="fa-solid fa-credit-card"></i> Payments</a>
                <a href="/admin/attendees" class="nav-link"><i class="fa-solid fa-users"></i> Attendees</a>
                <a href="/admin/refunds" class="nav-link"><i class="fa-solid fa-arrow-rotate-left"></i> Refunds</a>
                <a href="/admin/reports" class="nav-link"><i class="fa-solid fa-file-csv"></i> Reports</a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Standard Page Header -->
            <div class="page-header" style="margin-bottom: 2rem;">
                <div class="header-left">
                    <h3 style="margin: 0; color: #fff;">Events Management</h3>
                </div>

                <div class="header-right">



                    <!-- Profile Dropdown -->
                    <div class="profile-menu">
                        <div class="profile-icon" onclick="toggleDropdown()"
                            style="border: none; background: transparent; padding: 0;">
                            <div style="text-align: right; margin-right: 0.5rem;">
                                <div style="font-weight: 600; font-size: 0.9rem; color: #fff;">
                                    <%= user.name %>
                                </div>
                                <div style="font-size: 0.75rem; color: var(--text-secondary);">
                                    <%= user.role || 'Admin' %>
                                </div>
                            </div>
                            <i class="fa-solid fa-user-circle" style="font-size: 2rem; color: var(--primary);"></i>
                            <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem; margin-left: 0.5rem;"></i>
                        </div>
                        <div class="profile-dropdown" id="profileDropdown">
                            <div class="dropdown-header">
                                <strong>
                                    <%= user.name %>
                                </strong>
                                <p>
                                    <%= user.email %>
                                </p>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="/admin/profile" class="dropdown-item"><i class="fa-solid fa-user-pen"></i> Edit
                                Profile</a>
                            <a href="javascript:void(0)" onclick="openLogoutModal()"
                                class="dropdown-item text-danger"><i class="fa-solid fa-right-from-bracket"></i>
                                Logout</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Events List -->
            <div class="dashboard-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h3 style="margin: 0;"><i class="fa-solid fa-calendar-alt"></i> All Events</h3>
                    <div style="display: flex; gap: 1rem; align-items: center;">
                        <!-- <a href="/register" target="_blank" class="btn"
                            style="background: var(--surface-light); border: 1px solid var(--border-color); color: var(--text-secondary); text-decoration: none; padding: 0.5rem 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
                            <i class="fa-solid fa-external-link-alt"></i> Public Registration
                        </a> -->
                        <button class="btn"
                            style="background: var(--primary); color: #fff; width: auto; padding: 0.5rem 1.5rem; display: flex; align-items: center; gap: 0.5rem; white-space: nowrap; border: none;"
                            onclick="openModal()">
                            <i class="fa-solid fa-plus"></i> Create Event
                        </button>
                    </div>
                </div>

                <div class="entries-control"
                    style="margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: var(--text-secondary);">
                    <span>Show</span>
                    <select class="form-select form-select-sm" onchange="changeEntriesLimit(this.value)"
                        style="width: 70px; display: inline-block; padding: 0.25rem 0.5rem; border-radius: 6px; border: 1px solid var(--border-color); background: var(--surface-light); color: var(--text-primary);">
                        <option value="10" style="color: #000;" <%=pagination.limit===10 ? 'selected' : '' %>>10
                        </option>
                        <option value="20" style="color: #000;" <%=pagination.limit===20 ? 'selected' : '' %>>20
                        </option>
                        <option value="30" style="color: #000;" <%=pagination.limit===30 ? 'selected' : '' %>>30
                        </option>
                        <option value="50" style="color: #000;" <%=pagination.limit===50 ? 'selected' : '' %>>50
                        </option>
                    </select>
                    <span>entries</span>
                </div>
                <div class="table-responsive">
                    <table id="eventsTable" class="table table-dark-custom table-hover w-100">
                        <thead>
                            <tr>
                                <th>S.No.</th>
                                <th>Title</th>
                                <th>School</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Capacity</th>
                                <th>Cost</th>
                                <th>Date</th>
                                <th>Balance Due Date</th>
                                <th>Payments</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% events.forEach((event, index)=> { %>
                                <tr>
                                    <td>
                                        <%= (pagination.page - 1) * pagination.limit + index + 1 %>
                                    </td>
                                    <td class="fw-bold">
                                        <%= event.title %>
                                    </td>
                                    <td>
                                        <%= event.school.name %>
                                    </td>
                                    <td><span class="badge bg-secondary">
                                            <%= event.type || 'N/A' %>
                                        </span></td>
                                    <td>
                                        <% let statusClass='status-open' ; if(event.status==='CLOSED' )
                                            statusClass='status-closed' ; if(event.status==='COMPLETED' )
                                            statusClass='status-completed' ; if(event.status==='CANCELLED' )
                                            statusClass='status-cancelled' ; %>
                                            <span class="status-badge <%= statusClass %>">
                                                <%= event.status %>
                                            </span>
                                    </td>
                                    <td>
                                        <%= event._count.attendees %> / <%= event.capacity %>
                                    </td>
                                    <td>$<%= event.costPerAttendee.toFixed(2) %>
                                    </td>
                                    <td>
                                        <%= event.date ? new Date(event.date).toLocaleDateString() : 'TBD' %>
                                    </td>
                                    <td>
                                        <%= event.balanceDueDate ? new Date(event.balanceDueDate).toLocaleDateString()
                                            : 'N/A' %>
                                    </td>
                                    <td>
                                        <button class="action-btn text-primary"
                                            style="background: rgba(var(--primary-rgb), 0.1); padding: 0.4rem 0.8rem;"
                                            title="View Registrations & Payments"
                                            onclick="viewRegistrations('<%= index %>')">
                                            <i class="fa-solid fa-users"></i> View
                                        </button>
                                    </td>
                                    <td class="text-end" style="white-space: nowrap;">
                                        <a href="/event/<%= event.slug %>/register" target="_blank"
                                            class="action-btn text-success" title="Public Registration Link"
                                            style="text-decoration: none;">
                                            <i class="fa-solid fa-link"></i>
                                        </a>
                                        <button class="action-btn" title="Edit"
                                            onclick="editEvent('<%= event.id %>')"><i
                                                class="fa-solid fa-pen"></i></button>
                                        <button class="action-btn text-info" title="View"
                                            onclick="viewEvent('<%= event.id %>')"><i
                                                class="fa-solid fa-eye"></i></button>
                                        <button class="action-btn delete" title="Delete" data-id="<%= event.id %>"
                                            data-title="<%= event.title %>"
                                            onclick="deleteEvent(this.dataset.id, this.dataset.title)"><i
                                                class="fa-solid fa-trash"></i></button>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>

                <% if (pagination && pagination.totalPages> 1) { %>
                    <div class="pagination-container">
                        <% if (pagination.page> 1) { %>
                            <a href="?page=<%= pagination.page - 1 %>" class="page-link-btn">Previous</a>
                            <% } %>

                                <% for(let i=1; i<=pagination.totalPages; i++) { %>
                                    <a href="?page=<%= i %>"
                                        class="page-link-btn <%= i === pagination.page ? 'active' : '' %>">
                                        <%= i %>
                                    </a>
                                    <% } %>

                                        <% if (pagination.page < pagination.totalPages) { %>
                                            <a href="?page=<%= pagination.page + 1 %>" class="page-link-btn">Next</a>
                                            <% } %>
                    </div>
                    <% } %>
            </div>
        </main>
    </div>

    <!-- Create Event Modal -->
    <div class="custom-modal" id="createEventModal">
        <div class="custom-modal-content">
            <div class="custom-modal-header">
                <h3 style="margin: 0; color: var(--text-primary);">Create New Event</h3>
                <button type="button" class="close-btn" onclick="closeModal()">&times;</button>
            </div>
            <form id="createEventForm">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label">Event Title</label>
                        <input type="text" class="form-control" name="title" required
                            placeholder="e.g. Annual Gala 2026">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">School</label>
                        <select class="form-select" name="schoolId" required>
                            <option value="">Select a school...</option>
                            <% schools.forEach(s=> { %>
                                <option value="<%= s.id %>">
                                    <%= s.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Event Type</label>
                        <input type="text" class="form-control" name="type" placeholder="e.g. Conference">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <select class="form-select" name="status">
                            <option value="OPEN">Open</option>
                            <option value="CLOSED">Closed</option>
                            <option value="COMPLETED">Completed</option>
                            <option value="CANCELLED">Cancelled</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Capacity</label>
                        <input type="number" class="form-control" name="capacity" required min="1" value="100">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Cost Per Attendee ($)</label>
                        <input type="number" class="form-control" name="costPerAttendee" required min="0" value="0.00"
                            step="0.01">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Deposit %</label>
                        <input type="number" class="form-control" name="depositPercentage" min="0" max="100" value="0">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Event Date</label>
                        <input type="date" class="form-control" name="date">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Balance Due Date</label>
                        <input type="date" class="form-control" name="balanceDueDate">
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Venue</label>
                        <input type="text" class="form-control" name="venue" placeholder="e.g. Main Auditorium">
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" name="description" rows="3"
                            placeholder="Additional details..."></textarea>
                    </div>
                </div>

                <div id="formAlert" style="color: var(--danger); margin-top: 1rem; display: none;"></div>

                <div class="custom-modal-footer">
                    <button type="button" class="btn"
                        style="background: transparent; color: var(--text-secondary); width: auto;"
                        onclick="closeModal()">Cancel</button>
                    <button type="button" class="btn" style="width: auto;" id="saveEventBtn"
                        onclick="saveEventData()">Save Event</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="custom-modal" id="deleteEventModal">
        <div class="delete-modal-content">
            <h3>Confirm Delete</h3>
            <p>Are you sure you want to delete <span id="deleteEventName"
                    style="font-weight: 700; color: var(--text-primary);"></span>?</p>
            <div class="delete-modal-actions">
                <button type="button" class="delete-btn-cancel" onclick="closeDeleteModal()">Cancel</button>
                <button type="button" class="delete-btn-confirm" onclick="confirmDeleteEvent()">Delete</button>
            </div>
        </div>
    </div>

    <!-- View Event Modal -->
    <div class="custom-modal" id="viewEventModal">
        <div class="custom-modal-content">
            <div class="custom-modal-header">
                <h3 style="margin: 0; color: var(--text-primary);">Event Details</h3>
                <button type="button" class="close-btn" onclick="closeViewModal()">&times;</button>
            </div>
            <div id="viewEventDetails" style="color: var(--text-secondary); line-height: 1.6; font-size: 0.95rem;">
                <!-- Content injected via JS -->
            </div>
        </div>
    </div>

    <!-- Hidden Attendees Data for Modals -->
    <div id="hiddenAttendeesContainer" style="display: none;">
        <% events.forEach((event, index)=> { %>
            <div id="attendees-content-<%= index %>">
                <% if (event.attendees && event.attendees.length> 0) { %>
                    <table class="inner-table" style="margin: 0;">
                        <thead>
                            <tr>
                                <th>S.NO.</th>
                                <th>Name</th>
                                <th>Status</th>
                                <th>Actual amount</th>
                                <th>Paid</th>
                                <th>Balance Due</th>
                                <th>Date</th>
                                <th>Due Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% event.attendees.forEach((a, attIndex)=> {
                                let totalPaid = 0;
                                let totalPending = 0;
                                a.payments.forEach(p => {
                                if (p.status === 'SUCCESS' && p.type !== 'REFUND') totalPaid += p.amount;
                                if (p.status === 'PENDING') totalPending += p.amount;
                                });
                                let balanceDue = event.costPerAttendee - totalPaid;
                                if(balanceDue < 0) balanceDue=0; %>
                                    <tr>
                                        <td>
                                            <%= attIndex + 1 %>
                                        </td>
                                        <td>
                                            <%= a.fullName %>
                                        </td>
                                        <td>
                                            <%= a.status.replace('_', ' ' ) %>
                                                <% if (a.status==='BALANCE_PENDING' || a.status==='INCOMPLETE' ) { %>
                                                    <span
                                                        style="display:inline-block; margin-left: 5px; color: var(--warning);"
                                                        title="Payment Incomplete">
                                                        <i class="fa-solid fa-circle-exclamation"></i>
                                                    </span>
                                                    <% } %>
                                        </td>
                                        <td>$<%= event.costPerAttendee.toFixed(2) %>
                                        </td>
                                        <td style="color: #4ade80;">$<%= totalPaid.toFixed(2) %>
                                        </td>
                                        <% if (balanceDue> 0) { %>
                                            <td style="color: #f5210b;">
                                                <% } else { %>
                                            <td style="color: inherit;">
                                                <% } %>
                                                    $<%= balanceDue.toFixed(2) %>
                                            </td>
                                            <td>
                                                <%= new Date(a.createdAt).toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <%= event.balanceDueDate ? new
                                                    Date(event.balanceDueDate).toLocaleDateString() : '-' %>
                                            </td>
                                            <td>
                                                <% if (balanceDue> 0 && a.status !== 'REFUNDED') { %>
                                                    <button onclick="sendReminder('<%= a.id %>', this)"
                                                        title="Send Reminder Email"
                                                        style="background: none; border: none; color: var(--primary); cursor: pointer; font-size: 1.1rem; padding: 5px;">
                                                        <i class="fa-solid fa-bell"></i>
                                                    </button>
                                                    <% } else { %>
                                                        -
                                                        <% } %>
                                            </td>
                                    </tr>
                                    <% }) %>
                        </tbody>
                    </table>
                    <% } else { %>
                        <div style="color: var(--text-secondary); font-size: 0.9rem; padding: 1rem 0;">No attendees
                            registered yet.</div>
                        <% } %>
            </div>
            <% }) %>
    </div>

    <!-- Registrations Modal -->
    <div class="custom-modal" id="registrationsModal">
        <div class="custom-modal-content" style="max-width: 900px;">
            <div class="custom-modal-header">
                <h3 style="margin: 0; color: var(--text-primary);">Registrations & Payments</h3>
                <button type="button" class="close-btn" onclick="closeRegistrationsModal()">&times;</button>
            </div>
            <div id="registrationsModalBody" style="margin-top: 1rem; overflow-x: auto;">
                <!-- Content injected via JS -->
            </div>
        </div>
    </div>

    <!-- Reminder Confirmation Modal -->
    <div class="custom-modal" id="reminderModal" style="z-index: 10005;">
        <div class="delete-modal-content">
            <h3>Send Reminder</h3>
            <p>Send a payment reminder email to this attendee?</p>
            <div class="delete-modal-actions">
                <button type="button" class="delete-btn-cancel" onclick="closeReminderModal()">Cancel</button>
                <button type="button" class="delete-btn-confirm" style="background: var(--primary);"
                    onclick="confirmSendReminder()">Send</button>
            </div>
        </div>
    </div>

    <script id="eventsData" type="application/json">
    <%- JSON.stringify(events || []) %>
</script>

    <script>
        const allEvents = JSON.parse(document.getElementById('eventsData').textContent);
        let editingEventId = null;

        function openModal() {
            editingEventId = null;
            document.getElementById('createEventForm').reset();
            document.querySelector('.custom-modal-header h3').textContent = 'Create New Event';
            document.getElementById('createEventModal').classList.add('show');
        }

        function editEvent(id) {
            editingEventId = id;
            const event = allEvents.find(e => e.id === id);
            if (!event) return;

            const form = document.getElementById('createEventForm');
            form.reset();

            // Populate fields
            form.title.value = event.title || '';
            form.schoolId.value = event.schoolId || '';
            form.type.value = event.type || '';
            form.status.value = event.status || 'OPEN';
            form.capacity.value = event.capacity || 100;
            form.costPerAttendee.value = event.costPerAttendee || 0.00;
            form.depositPercentage.value = event.depositPercentage || 0;
            form.venue.value = event.venue || '';
            form.description.value = event.description || '';

            if (event.date) {
                form.date.value = new Date(event.date).toISOString().split('T')[0];
            }
            if (event.balanceDueDate) {
                form.balanceDueDate.value = new Date(event.balanceDueDate).toISOString().split('T')[0];
            }

            document.querySelector('.custom-modal-header h3').textContent = 'Edit Event';
            document.getElementById('createEventModal').classList.add('show');
        }

        function closeModal() {
            document.getElementById('createEventModal').classList.remove('show');
            editingEventId = null;
        }

        function viewEvent(id) {
            const event = allEvents.find(e => e.id === id);
            if (!event) return;

            const detailsHtml = `
                <div class="row">
                    <div class="col-md-12" style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
                        <h4 style="color: #fff; margin-bottom: 0.5rem; font-size: 1.3rem;">${event.title}</h4>
                        <span class="status-badge status-${event.status.toLowerCase()}">${event.status}</span>
                    </div>
                    <div class="col-md-6" style="margin-bottom: 0.8rem;"><strong>School:</strong> ${event.school.name}</div>
                    <div class="col-md-6" style="margin-bottom: 0.8rem;"><strong>Type:</strong> ${event.type || 'N/A'}</div>
                    <div class="col-md-6" style="margin-bottom: 0.8rem;"><strong>Capacity:</strong> ${event.capacity}</div>
                    <div class="col-md-6" style="margin-bottom: 0.8rem;"><strong>Cost Per Attendee:</strong> $${(event.costPerAttendee || 0).toFixed(2)}</div>
                    <div class="col-md-6" style="margin-bottom: 0.8rem;"><strong>Deposit %:</strong> ${event.depositPercentage || 0}%</div>
                    <div class="col-md-6" style="margin-bottom: 0.8rem;"><strong>Event Date:</strong> ${event.date ? new Date(event.date).toLocaleDateString() : 'TBD'}</div>
                    <div class="col-md-6" style="margin-bottom: 0.8rem;"><strong>Balance Due Date:</strong> ${event.balanceDueDate ? new Date(event.balanceDueDate).toLocaleDateString() : 'N/A'}</div>
                    <div class="col-md-12" style="margin-bottom: 0.8rem;"><strong>Venue:</strong> ${event.venue || 'N/A'}</div>
                    <div class="col-md-12" style="margin-top: 0.5rem; background: rgba(255,255,255,0.02); padding: 1rem; border-radius: 8px;">
                        <strong>Description:</strong><br/> 
                        <div style="margin-top: 0.5rem; white-space: pre-wrap;">${event.description || 'No description provided.'}</div>
                    </div>
                </div>
            `;
            document.getElementById('viewEventDetails').innerHTML = detailsHtml;
            document.getElementById('viewEventModal').classList.add('show');
        }

        function closeViewModal() {
            document.getElementById('viewEventModal').classList.remove('show');
        }

        async function saveEventData() {
            const form = document.getElementById('createEventForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const btn = document.getElementById('saveEventBtn');
            const alertBox = document.getElementById('formAlert');
            btn.disabled = true;
            btn.innerHTML = 'Saving...';
            alertBox.style.display = 'none';

            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            // Convert numbers
            data.capacity = parseInt(data.capacity);
            data.costPerAttendee = parseFloat(data.costPerAttendee);
            data.depositPercentage = parseFloat(data.depositPercentage);
            if (!data.date) delete data.date;
            if (!data.balanceDueDate) delete data.balanceDueDate;

            if (data.date && data.balanceDueDate) {
                if (new Date(data.balanceDueDate) > new Date(data.date)) {
                    alertBox.textContent = 'Balance Due Date cannot be after the Event Date.';
                    alertBox.style.display = 'block';
                    btn.disabled = false;
                    btn.innerHTML = 'Save Event';
                    return;
                }
            }

            try {
                const url = editingEventId ? '/api/events/' + editingEventId : '/api/events';
                const method = editingEventId ? 'PATCH' : 'POST';

                const res = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();

                if (result.success) {
                    showToast(result.message, 'success');
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    alertBox.textContent = result.message;
                    alertBox.style.display = 'block';
                    btn.disabled = false;
                    btn.innerHTML = 'Save Event';
                }
            } catch (err) {
                alertBox.textContent = 'Network error occurred.';
                alertBox.style.display = 'block';
                btn.disabled = false;
                btn.innerHTML = 'Save Event';
            }
        }

        let eventToDelete = null;

        function deleteEvent(id, title) {
            eventToDelete = id;
            document.getElementById('deleteEventName').textContent = title;
            document.getElementById('deleteEventModal').classList.add('show');
        }

        function closeDeleteModal() {
            eventToDelete = null;
            document.getElementById('deleteEventModal').classList.remove('show');
        }

        async function confirmDeleteEvent() {
            if (!eventToDelete) return;

            try {
                const res = await fetch('/api/events/' + eventToDelete, { method: 'DELETE' });
                const result = await res.json();
                if (result.success) {
                    showToast(result.message, 'success');
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast('Error: ' + result.message, 'error');
                    closeDeleteModal();
                }
            } catch (err) {
                showToast('Network error occurred.', 'error');
                closeDeleteModal();
            }
        }

        function toggleDropdown() {
            document.getElementById("profileDropdown").classList.toggle("show");
        }

        window.onclick = function (event) {
            if (!event.target.closest('.profile-menu')) {
                var dropdowns = document.getElementsByClassName("profile-dropdown");
                for (var i = 0; i < dropdowns.length; i++) {
                    var openDropdown = dropdowns[i];
                    if (openDropdown.classList.contains('show')) {
                        openDropdown.classList.remove('show');
                    }
                }
            }
        }

        function viewRegistrations(index) {
            const content = document.getElementById('attendees-content-' + index).innerHTML;
            document.getElementById('registrationsModalBody').innerHTML = content;
            document.getElementById('registrationsModal').classList.add('show');
        }

        function closeRegistrationsModal() {
            document.getElementById('registrationsModal').classList.remove('show');
        }

        let reminderAttendeeId = null;
        let reminderBtnElement = null;

        function sendReminder(attendeeId, btnElement) {
            reminderAttendeeId = attendeeId;
            reminderBtnElement = btnElement;
            document.getElementById('reminderModal').classList.add('show');
        }

        function closeReminderModal() {
            reminderAttendeeId = null;
            reminderBtnElement = null;
            document.getElementById('reminderModal').classList.remove('show');
        }

        async function confirmSendReminder() {
            if (!reminderAttendeeId || !reminderBtnElement) return;

            const attendeeId = reminderAttendeeId;
            const btnElement = reminderBtnElement;

            closeReminderModal();

            const originalHtml = btnElement.innerHTML;
            btnElement.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
            btnElement.disabled = true;

            try {
                const res = await fetch(`/api/attendees/${attendeeId}/reminders/balance`, {
                    method: 'POST'
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Reminder sent successfully!', 'success');
                    btnElement.innerHTML = '<i class="fa-solid fa-check" style="color: var(--success);"></i>';
                } else {
                    showToast('Failed: ' + data.message, 'error');
                    btnElement.innerHTML = originalHtml;
                    btnElement.disabled = false;
                }
            } catch (err) {
                showToast('Error sending reminder', 'error');
                btnElement.innerHTML = originalHtml;
                btnElement.disabled = false;
            }
        }
    </script>
    </body>

    </html>