<%- include('../layout/head', { title: 'Reports | EZPay2Attend' }) %>

    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="sidebar-logo">EZPay2Attend</div>
            <nav>
                <a href="/admin" class="nav-link"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                <a href="/admin/events" class="nav-link"><i class="fa-solid fa-calendar-alt"></i> Events</a>
                <a href="/admin/schools" class="nav-link"><i class="fa-solid fa-school"></i> Schools</a>
                <a href="/admin/attendees" class="nav-link"><i class="fa-solid fa-users"></i> Attendee/Registrations</a>
                <!-- <a href="/admin/payments" class="nav-link"><i class="fa-solid fa-credit-card"></i> Payments</a>
                <a href="/admin/refunds" class="nav-link"><i class="fa-solid fa-arrow-rotate-left"></i> Refunds</a>
                <a href="/admin/reports" class="nav-link active"><i class="fa-solid fa-file-csv"></i> Reports</a> -->
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <div class="header-left">
                    <h3 style="margin: 0; color: #fff;">Generate Reports</h3>
                </div>

                <div class="header-right">
                    <div class="profile-menu">
                        <div class="profile-icon" onclick="toggleDropdown()"
                            style="border: none; background: transparent; padding: 0;">
                            <div style="text-align: right; margin-right: 0.5rem;">
                                <div style="font-weight: 600; font-size: 0.9rem; color: #fff;">
                                    <%= user.name %>
                                </div>
                                <div style="font-size: 0.75rem; color: var(--text-secondary);">
                                    <%= user.role || 'Admin' %>
                                </div>
                            </div>
                            <i class="fa-solid fa-user-circle" style="font-size: 2rem; color: var(--primary);"></i>
                            <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem; margin-left: 0.5rem;"></i>
                        </div>
                        <div class="profile-dropdown" id="profileDropdown">
                            <div class="dropdown-header">
                                <strong>
                                    <%= user.name %>
                                </strong>
                                <div style="font-size: 0.8rem; color: var(--text-secondary);">
                                    <%= user.email %>
                                </div>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="/admin/profile" class="dropdown-item"><i class="fa-solid fa-user-pen"></i> Edit
                                Profile</a>
                            <a href="javascript:void(0)" onclick="openLogoutModal()"
                                class="dropdown-item text-danger"><i class="fa-solid fa-right-from-bracket"></i>
                                Logout</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-card profile-card" style="max-width: 800px; margin: 2rem auto;">
                <h4 style="margin-top: 0; color: #fff; margin-bottom: 1.5rem; text-align: center; font-size: 1.5rem;">
                    Report Configuration</h4>

                <form id="reportForm" onsubmit="handleReportSubmit(event)">
                    <div class="form-group mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-weight: 500;">Report
                            Type</label>
                        <select class="form-control" name="type" id="reportType" required onchange="toggleFilters()">
                            <option value="attendee">Attendee Report</option>
                            <option value="payment">Payment Report</option>
                            <option value="event">Event Report</option>
                            <option value="financial">Financial Report</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-weight: 500;">Select
                            Event</label>
                        <select class="form-control" name="eventId" required>
                            <option value="">-- Select an Event --</option>
                            <% events.forEach(e=> { %>
                                <option value="<%= e.id %>">
                                    <%= e.title %> (<%= e.school.name %>)
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
                        <div class="form-group" style="flex: 1; margin-bottom: 0;">
                            <label class="form-label" style="color: var(--text-secondary); font-weight: 500;">Start
                                Date</label>
                            <input type="date" class="form-control" name="startDate" required>
                        </div>
                        <div class="form-group" style="flex: 1; margin-bottom: 0;">
                            <label class="form-label" style="color: var(--text-secondary); font-weight: 500;">End
                                Date</label>
                            <input type="date" class="form-control" name="endDate" required>
                        </div>
                    </div>

                    <div style="display: flex; gap: 1rem; margin-bottom: 2rem;" id="statusFilters">
                        <div class="form-group mb-4" id="regStatusContainer">
                            <label class="form-label"
                                style="color: var(--text-secondary); font-weight: 500;">Registration Status</label>
                            <select class="form-control" name="registrationStatus" required>
                                <option value="">-- Select Status --</option>
                                <option value="CONFIRMED">Confirmed</option>
                                <option value="INCOMPLETE">Incomplete</option>
                                <option value="BALANCE_PENDING">Balance Pending</option>
                                <option value="BALANCE_OVERDUE">Balance Overdue</option>
                                <option value="REFUNDED">Refunded</option>
                                <option value="REPLACED">Replaced</option>
                                <option value="REFUND_REQUESTED">Refund Requested</option>
                            </select>
                        </div>
                        <div class="form-group mb-4" id="payStatusContainer" style="display: none;">
                            <label class="form-label" style="color: var(--text-secondary); font-weight: 500;">Payment
                                Status</label>
                            <select class="form-control" name="paymentStatus" required>
                                <option value="">-- Select Status --</option>
                                <option value="SUCCESS">Success</option>
                                <option value="PENDING">Pending</option>
                                <option value="FAILED">Failed</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn"
                        style="background: var(--primary); color: #fff; width: 100%; padding: 0.8rem; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem; transition: background 0.3s ease;">
                        <i class="fa-solid fa-download"></i> Generate & Download Report
                    </button>
                </form>
            </div>
        </main>
    </div>


    <script>
        function toggleDropdown() {
            document.getElementById("profileDropdown").classList.toggle("show");
        }

        window.onclick = function (event) {
            if (!event.target.closest('.profile-menu')) {
                var dropdowns = document.getElementsByClassName("profile-dropdown");
                for (var i = 0; i < dropdowns.length; i++) {
                    var openDropdown = dropdowns[i];
                    if (openDropdown.classList.contains('show')) {
                        openDropdown.classList.remove('show');
                    }
                }
            }
        }

        function toggleFilters() {
            const type = document.getElementById('reportType').value;
            const regStatus = document.getElementById('regStatusContainer');
            const payStatus = document.getElementById('payStatusContainer');

            const regSelect = document.querySelector('select[name="registrationStatus"]');
            const paySelect = document.querySelector('select[name="paymentStatus"]');

            if (type === 'attendee') {
                regStatus.style.display = 'block';
                payStatus.style.display = 'none';
                regSelect.required = true;
                paySelect.required = false;
            } else if (type === 'payment') {
                regStatus.style.display = 'none';
                payStatus.style.display = 'block';
                regSelect.required = false;
                paySelect.required = true;
            } else {
                regStatus.style.display = 'none';
                payStatus.style.display = 'none';
                regSelect.required = false;
                paySelect.required = false;
            }
        }

        // Initialize display
        toggleFilters();


        async function handleReportSubmit(e) {
            e.preventDefault();
            const form = document.getElementById('reportForm');
            const formData = new FormData(form);
            const queryParams = new URLSearchParams(formData).toString();

            const btn = form.querySelector('button[type="submit"]');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Checking Data...';
            btn.disabled = true;

            try {
                const res = await fetch(`/admin/export/custom?${queryParams}&format=json`);
                const result = await res.json();

                if (result.success && result.data && result.data.length > 0) {
                    window.location.href = `/admin/export/custom?${queryParams}`;
                    showToast('Report generated successfully!', 'success');
                } else {
                    showToast('No data found for the selected filters!', 'error');
                }
            } catch (err) {
                showToast('Network error while generating report.', 'error');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }
    </script>
    </body>

    </html>