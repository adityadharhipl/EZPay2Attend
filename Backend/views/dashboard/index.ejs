<%- include('../layout/head', { title: 'Dashboard | EZPay2Attend' }) %>
    <style>
        .accordion-header {
            cursor: pointer;
            padding: 0.5rem 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 8px;
            transition: background 0.2s;
        }

        .accordion-header:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .accordion-header h3 {
            margin: 0;
        }

        .accordion-header .toggle-icon {
            transition: transform 0.3s ease;
        }

        .accordion-header.collapsed .toggle-icon {
            transform: rotate(-90deg);
        }

        .accordion-content {
            transition: max-height 0.3s ease-out, opacity 0.3s ease-out, margin-top 0.3s ease;
            overflow: hidden;
            max-height: 800px;
            /* arbitrary large value */
            opacity: 1;
            margin-top: 1rem;
        }

        .accordion-content.collapsed {
            max-height: 0;
            opacity: 0;
            margin-top: 0;
        }

        .accordion-scroll {
            max-height: 350px;
            overflow-y: auto;
        }

        /* Scrollbar styling */
        .accordion-scroll::-webkit-scrollbar {
            width: 8px;
        }

        .accordion-scroll::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }

        .accordion-scroll::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }

        .accordion-scroll::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .action-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            transition: all 0.2s;
        }

        .action-btn:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-primary);
        }

        .custom-modal {
            display: none;
            position: fixed;
            z-index: 10000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.6);
            align-items: center;
            justify-content: center;
        }

        .custom-modal-content {
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            width: 90%;
            max-width: 700px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 1.5rem;
        }

        .custom-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 1rem;
            margin-bottom: 1rem;
        }

        .close-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-size: 1.5rem;
            cursor: pointer;
        }
    </style>

    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="sidebar-logo">EZPay2Attend</div>
            <nav>
                <a href="/admin" class="nav-link active"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                <a href="/admin/events" class="nav-link"><i class="fa-solid fa-calendar-alt"></i> Events</a>
                <a href="/admin/schools" class="nav-link"><i class="fa-solid fa-school"></i> Schools</a>
                <a href="/admin/payments" class="nav-link"><i class="fa-solid fa-credit-card"></i> Payments</a>
                <a href="/admin/attendees" class="nav-link"><i class="fa-solid fa-users"></i> Attendees</a>
                <a href="/admin/refunds" class="nav-link"><i class="fa-solid fa-arrow-rotate-left"></i> Refunds</a>
                <a href="/admin/reports" class="nav-link"><i class="fa-solid fa-file-csv"></i> Reports</a>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <div class="header-left">
                </div>

                <div class="header-right">



                    <!-- Profile Dropdown -->
                    <div class="profile-menu">
                        <div class="profile-icon" onclick="toggleDropdown()"
                            style="border: none; background: transparent; padding: 0;">
                            <div style="text-align: right; margin-right: 0.5rem;">
                                <div style="font-weight: 600; font-size: 0.9rem; color: #fff;">
                                    <%= user.name %>
                                </div>
                                <div style="font-size: 0.75rem; color: var(--text-secondary);">
                                    <%= user.role || 'Admin' %>
                                </div>
                            </div>
                            <i class="fa-solid fa-user-circle" style="font-size: 2rem; color: var(--primary);"></i>
                            <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem; margin-left: 0.5rem;"></i>
                        </div>
                        <div class="profile-dropdown" id="profileDropdown">
                            <div class="dropdown-header">
                                <strong>
                                    <%= user.name %>
                                </strong>
                                <p>
                                    <%= user.email %>
                                </p>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="/admin/profile" class="dropdown-item"><i class="fa-solid fa-user-pen"></i> Edit
                                Profile</a>
                            <a href="javascript:void(0)" onclick="openLogoutModal()"
                                class="dropdown-item text-danger"><i class="fa-solid fa-right-from-bracket"></i>
                                Logout</a>
                        </div>
                    </div>
                </div>
            </div>

            <% if (typeof error !=='undefined' && error) { %>
                <div class="alert error">
                    <%= error %>
                </div>
                <% } %>

                    <% if (metrics) { %>
                        <!-- Metrics Grid -->
                        <div class="metrics-grid">
                            <div class="metric-card">
                                <div class="metric-card-header">
                                    Total Events <i class="fa-solid fa-calendar-days"></i>
                                </div>
                                <div class="metric-card-value">
                                    <%= metrics.totalEvents %>
                                </div>
                            </div>

                            <div class="metric-card">
                                <div class="metric-card-header">
                                    Total Registrations <i class="fa-solid fa-users"></i>
                                </div>
                                <div class="metric-card-value">
                                    <%= metrics.totalRegistrations %>

                                </div>
                            </div>

                            <div class="metric-card">
                                <div class="metric-card-header">
                                    Confirmed Attendees <i class="fa-solid fa-user-check"></i>
                                </div>
                                <div class="metric-card-value">
                                    <%= metrics.confirmedAttendees %>

                                </div>
                            </div>

                            <div class="metric-card">
                                <div class="metric-card-header">
                                    Capacity Utilization <i class="fa-solid fa-percent"></i>
                                </div>
                                <div class="metric-card-value">
                                    <%= metrics.capacityUtilization %>%

                                </div>
                            </div>
                            <div class="metric-card">
                                <div class="metric-card-header">
                                    Outstanding Payments <i class="fa-solid fa-file-invoice-dollar"></i>
                                </div>
                                <div class="metric-card-value" style="color: var(--warning);">
                                    $<%= metrics.outstandingBalance.toLocaleString() %>

                                </div>
                            </div>

                            <div class="metric-card">
                                <div class="metric-card-header">
                                    Total Revenue <i class="fa-solid fa-money-bill-wave"></i>
                                </div>
                                <div class="metric-card-value">
                                    $<%= metrics.totalRevenue.toLocaleString() %>

                                </div>
                            </div>



                            <div class="metric-card">
                                <div class="metric-card-header">
                                    Pending Payments <i class="fa-solid fa-clock"></i>
                                </div>
                                <div class="metric-card-value">
                                    <%= metrics.outstandingPayments %>
                                </div>
                            </div>

                            <div class="metric-card">
                                <div class="metric-card-header">
                                    Pending Refund Requests <i class="fa-solid fa-arrow-rotate-left"></i>
                                </div>
                                <div class="metric-card-value">
                                    <%= metrics.pendingRefunds %>
                                </div>
                            </div>
                        </div>

                        <!-- Event Dashboard Summary -->
                        <div class="dashboard-section">
                            <div class="accordion-header" onclick="toggleAccordion('eventSummary')">
                                <h3><i class="fa-solid fa-list-check"></i> Event Dashboard </h3>
                                <i class="fa-solid fa-chevron-down toggle-icon" id="eventSummaryIcon"></i>
                            </div>
                            <div class="accordion-content" id="eventSummaryContent">
                                <div class="table-responsive accordion-scroll">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>S.No.</th>
                                                <th>Event Title</th>
                                                <th>Date</th>
                                                <th>Attendees</th>
                                                <th>Capacity</th>
                                                <th>Status</th>
                                                <th>Attendee List</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (metrics.recentEvents.length===0) { %>
                                                <tr>
                                                    <td colspan="6"
                                                        style="text-align: center; color: var(--text-secondary);">No
                                                        events found.</td>
                                                </tr>
                                                <% } else { %>
                                                    <% metrics.recentEvents.forEach((event, index)=> { %>
                                                        <tr>
                                                            <td>
                                                                <%= index + 1 %>
                                                            </td>
                                                            <td><strong>
                                                                    <%= event.title %>
                                                                </strong></td>
                                                            <td>
                                                                <%= event.date ? new
                                                                    Date(event.date).toLocaleDateString() : 'TBD' %>
                                                            </td>
                                                            <td>
                                                                <%= event._count.attendees %>
                                                            </td>
                                                            <td>
                                                                <%= event.capacity %>
                                                            </td>
                                                            <td>
                                                                <span
                                                                    class="badge <%= event.status === 'OPEN' ? 'success' : (event.status === 'CLOSED' ? 'warning' : 'info') %>">
                                                                    <%= event.status %>
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <button class="action-btn text-info"
                                                                    title="View Attendees"
                                                                    onclick="openAttendeesModal('<%= index %>')"><i
                                                                        class="fa-solid fa-eye"></i></button>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Financial Dashboard Summary -->
                        <div class="dashboard-section">
                            <div class="accordion-header" onclick="toggleAccordion('financialDashboard')">
                                <h3><i class="fa-solid fa-wallet"></i> Financial Dashboard</h3>
                                <i class="fa-solid fa-chevron-down toggle-icon" id="financialDashboardIcon"></i>
                            </div>
                            <div class="accordion-content" id="financialDashboardContent">

                                <% let safeEvents=metrics.allEvents ? metrics.allEvents : metrics.recentEvents; let
                                    revLimit=5; let revTotalPages=Math.ceil(safeEvents.length / revLimit); %>

                                    <h4 style="margin-top: 1rem; color: #fff; margin-bottom: 0.5rem;">Revenue per Event
                                    </h4>
                                    <div class="table-responsive">
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th>S.No.</th>
                                                    <th>Event Title</th>
                                                    <th>Total Revenue</th>
                                                    <th>Outstanding Balance</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (safeEvents.length===0) { %>
                                                    <tr>
                                                        <td colspan="4"
                                                            style="text-align: center; color: var(--text-secondary);">No
                                                            events found.</td>
                                                    </tr>
                                                    <% } else { %>
                                                        <% safeEvents.forEach((event, index)=> {
                                                            let collected = 0;
                                                            let outstanding = 0;
                                                            if(event.attendees) {
                                                            event.attendees.forEach(a => {
                                                            a.payments.forEach(p => {
                                                            if(p.status === 'SUCCESS' && p.type !== 'REFUND') collected
                                                            += p.amount;
                                                            if(p.status === 'PENDING' && p.type !== 'REFUND')
                                                            outstanding += p.amount;
                                                            });
                                                            });
                                                            }
                                                            let pageNum = Math.floor(index / revLimit) + 1;
                                                            %>
                                                            <tr class="rev-row" data-page="<%= pageNum %>" <%-
                                                                pageNum===1 ? '' : 'style="display: none;"' %>>
                                                                <td>
                                                                    <%= index + 1 %>
                                                                </td>
                                                                <td><strong>
                                                                        <%= event.title %>
                                                                    </strong></td>
                                                                <td style="color: var(--success); font-weight: 500;">$
                                                                    <%= collected.toLocaleString() %>
                                                                </td>
                                                                <td style="color: var(--warning); font-weight: 500;">$
                                                                    <%= outstanding.toLocaleString() %>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                    <!-- Pagination for Revenue -->
                                    <% if(revTotalPages> 1) { %>
                                        <div
                                            style="display: flex; justify-content: flex-end; align-items: center; margin-top: 1rem; margin-bottom: 1rem; gap: 1rem;">
                                            <button type="button" id="revPrevBtn" onclick="changeRevPage(-1)"
                                                style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 6px; background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.3); border: none; cursor: not-allowed; transition: background 0.2s;"><i
                                                    class="fa-solid fa-chevron-left"></i></button>

                                            <span id="revPageText"
                                                style="color: var(--text-secondary); font-size: 0.9rem; font-weight: 500;"
                                                data-total="<%= revTotalPages %>">Page 1 of <%= revTotalPages %></span>

                                            <button type="button" id="revNextBtn" onclick="changeRevPage(1)"
                                                style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 6px; background: rgba(255,255,255,0.1); color: #fff; border: none; cursor: pointer; transition: background 0.2s;"><i
                                                    class="fa-solid fa-chevron-right"></i></button>
                                        </div>
                                        <% } %>

                                            <% let safePayments=metrics.recentPayments || []; %>

                                                <h4 style="margin-top: 2rem; color: #fff; margin-bottom: 0.5rem;">
                                                    Payment Reports (Recent)</h4>
                                                <div class="table-responsive">
                                                    <table class="table">
                                                        <thead>
                                                            <tr>
                                                                <th>S.No.</th>
                                                                <th>Attendee</th>
                                                                <th>Event</th>
                                                                <th>Type</th>
                                                                <th>Amount</th>
                                                                <th>Status</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <% if (safePayments.length===0) { %>
                                                                <tr>
                                                                    <td colspan="6"
                                                                        style="text-align: center; color: var(--text-secondary);">
                                                                        No payments found.</td>
                                                                </tr>
                                                                <% } else { %>
                                                                    <% safePayments.forEach((payment, index)=> {
                                                                        %>
                                                                        <tr class="pay-row">
                                                                            <td>
                                                                                <%= index + 1 %>
                                                                            </td>
                                                                            <td>
                                                                                <%= payment.attendee.fullName %>
                                                                            </td>
                                                                            <td>
                                                                                <%= payment.attendee.event.title %>
                                                                            </td>
                                                                            <td><span class="badge info">
                                                                                    <%= payment.type %>
                                                                                </span></td>
                                                                            <td>$<%= payment.amount.toLocaleString() %>
                                                                            </td>
                                                                            <td>
                                                                                <span
                                                                                    class="badge <%= payment.status === 'SUCCESS' ? 'success' : (payment.status === 'PENDING' ? 'warning' : 'danger') %>">
                                                                                    <%= payment.status %>
                                                                                </span>
                                                                            </td>
                                                                        </tr>
                                                                        <% }) %>
                                                                            <% } %>
                                                        </tbody>
                                                    </table>
                                                </div>

                            </div>
                        </div>
                        <% } %>

        </main>
    </div>

    <!-- View Attendees Modal -->
    <div class="custom-modal" id="attendeesModal">
        <div class="custom-modal-content" style="max-width: 900px;">
            <div class="custom-modal-header">
                <h3 style="margin: 0; color: var(--text-primary);">Attendee List</h3>
                <button type="button" class="close-btn" onclick="closeAttendeesModal()">&times;</button>
            </div>
            <div id="attendeesModalBody" style="margin-top: 1rem;">
                <!-- Content injected via JS -->
            </div>
        </div>
    </div>

    <!-- Hidden Attendees Data for Modals -->
    <div id="hiddenAttendeesContainer" style="display: none;">
        <% metrics.recentEvents.forEach((event, index)=> { %>
            <div id="attendees-content-<%= index %>">
                <% if(event.attendees && event.attendees.length> 0) { %>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>S.No.</th>
                                    <th>Name</th>
                                    <th>Registration Date</th>
                                    <th>Deposit Status</th>
                                    <th>Balance Status</th>
                                    <th>Payment Summary</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% event.attendees.forEach((a, attIndex)=> {
                                    let totalPaid = 0;
                                    a.payments.forEach(p => {
                                    if (p.status === 'SUCCESS' && p.type !== 'REFUND') totalPaid += p.amount;
                                    });
                                    let balanceDue = event.costPerAttendee - totalPaid;
                                    if(balanceDue < 0) balanceDue=0; let pageNum=Math.floor(attIndex / 10) + 1; %>
                                        <tr class="modal-attendee-row" data-page="<%= pageNum %>" <%- pageNum===1 ? ''
                                            : 'style="display: none;"' %>>
                                            <td>
                                                <%= attIndex + 1 %>
                                            </td>
                                            <td>
                                                <%= a.fullName %>
                                            </td>
                                            <td>
                                                <%= new Date(a.createdAt).toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <span
                                                    class="badge status-<%= a.status === 'REFUND_REQUESTED' ? 'refunded' : a.status.toLowerCase() %>"
                                                    style="font-size: 0.75rem;">
                                                    <%= a.status==='REFUND_REQUESTED' ? 'REFUND' :
                                                        a.status.replace('_', ' ' ) %>
                                                </span>
                                            </td>
                                            <td>
                                                <% if(balanceDue> 0) { %>
                                                    <span style="color: var(--danger); font-weight: 500;">Due: $<%=
                                                            balanceDue.toFixed(2) %></span>
                                                    <% } else { %>
                                                        <span
                                                            style="color: var(--success); font-weight: 500;">Paid</span>
                                                        <% } %>
                                            </td>
                                            <td>
                                                <div style="font-size: 0.85rem;">
                                                    <strong>Total Cost:</strong> $<%= event.costPerAttendee.toFixed(2)
                                                        %><br>
                                                        <strong style="color: var(--success);">Paid:</strong> $<%=
                                                            totalPaid.toFixed(2) %>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% let totalPages=Math.ceil(event.attendees.length / 10); %>
                        <% if (totalPages> 1) { %>
                            <div class="modal-pagination-controls"
                                style="display: flex; justify-content: flex-end; align-items: center; padding-top: 1rem; gap: 0.5rem;">
                                <button type="button" class="action-btn" style="font-size: 1.1rem;"
                                    onclick="changeModalPage(-1, Number('<%= totalPages %>'))"><i
                                        class="fa-solid fa-chevron-left"></i></button>
                                <span style="color: var(--text-secondary); font-size: 0.9rem; margin: 0 0.5rem;">Page
                                    <span id="currentModalPageDisplay">1</span> of <%= totalPages %></span>
                                <button type="button" class="action-btn" style="font-size: 1.1rem;"
                                    onclick="changeModalPage(1, Number('<%= totalPages %>'))"><i
                                        class="fa-solid fa-chevron-right"></i></button>
                            </div>
                            <% } %>
                                <% } else { %>
                                    <div style="color: var(--text-secondary); font-size: 0.9rem;">No attendees
                                        registered yet.</div>
                                    <% } %>
            </div>
            <% }) %>
    </div>
    <script>
        function toggleDropdown() {
            document.getElementById("profileDropdown").classList.toggle("show");
        }

        function toggleAccordion(id) {
            const header = document.querySelector(`[onclick="toggleAccordion('${id}')"]`);
            const content = document.getElementById(`${id}Content`);
            header.classList.toggle('collapsed');
            content.classList.toggle('collapsed');
        }

        let currentModalPage = 1;

        function openAttendeesModal(index) {
            currentModalPage = 1;
            const content = document.getElementById('attendees-content-' + index).innerHTML;
            document.getElementById('attendeesModalBody').innerHTML = content;
            document.getElementById('attendeesModal').style.display = 'flex';
            renderModalPage();
        }

        function closeAttendeesModal() {
            document.getElementById('attendeesModal').style.display = 'none';
        }

        function changeModalPage(delta, totalPages) {
            currentModalPage += delta;
            if (currentModalPage < 1) currentModalPage = 1;
            if (currentModalPage > totalPages) currentModalPage = totalPages;
            renderModalPage();
        }

        function renderModalPage() {
            const rows = document.getElementById('attendeesModalBody').querySelectorAll('.modal-attendee-row');
            if (rows.length === 0) return;
            rows.forEach(row => {
                if (parseInt(row.getAttribute('data-page')) === currentModalPage) {
                    row.style.display = 'table-row';
                } else {
                    row.style.display = 'none';
                }
            });
            const display = document.getElementById('attendeesModalBody').querySelector('#currentModalPageDisplay');
            if (display) display.textContent = currentModalPage;
        }

        let currentRevPage = 1;
        function changeRevPage(delta) {
            const totalPages = parseInt(document.getElementById('revPageText').getAttribute('data-total')) || 1;
            currentRevPage += delta;
            if (currentRevPage < 1) currentRevPage = 1;
            if (currentRevPage > totalPages) currentRevPage = totalPages;

            document.querySelectorAll('.rev-row').forEach(row => {
                if (parseInt(row.getAttribute('data-page')) === currentRevPage) {
                    row.style.display = 'table-row';
                } else {
                    row.style.display = 'none';
                }
            });
            document.getElementById('revPageText').textContent = 'Page ' + currentRevPage + ' of ' + totalPages;

            // Update buttons state
            const prevBtn = document.getElementById('revPrevBtn');
            const nextBtn = document.getElementById('revNextBtn');
            if (prevBtn) {
                if (currentRevPage === 1) {
                    prevBtn.style.background = 'rgba(255,255,255,0.05)';
                    prevBtn.style.color = 'rgba(255,255,255,0.3)';
                    prevBtn.style.cursor = 'not-allowed';
                } else {
                    prevBtn.style.background = 'rgba(255,255,255,0.1)';
                    prevBtn.style.color = '#fff';
                    prevBtn.style.cursor = 'pointer';
                }
            }
            if (nextBtn) {
                if (currentRevPage === totalPages) {
                    nextBtn.style.background = 'rgba(255,255,255,0.05)';
                    nextBtn.style.color = 'rgba(255,255,255,0.3)';
                    nextBtn.style.cursor = 'not-allowed';
                } else {
                    nextBtn.style.background = 'rgba(255,255,255,0.1)';
                    nextBtn.style.color = '#fff';
                    nextBtn.style.cursor = 'pointer';
                }
            }
        }



        // Close the dropdown if the user clicks outside of it
        window.onclick = function (event) {
            if (!event.target.closest('.profile-menu')) {
                var dropdowns = document.getElementsByClassName("profile-dropdown");
                for (var i = 0; i < dropdowns.length; i++) {
                    var openDropdown = dropdowns[i];
                    if (openDropdown.classList.contains('show')) {
                        openDropdown.classList.remove('show');
                    }
                }
            }
        }
    </script>
    </body>

    </html>