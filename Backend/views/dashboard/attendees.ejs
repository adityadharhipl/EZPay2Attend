<%- include('../layout/head', { title: title || 'Attendees | EZPay2Attend' }) %>
    <style>
        .events-container {
            padding: 2rem;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .table-dark-custom {
            background: var(--surface-light);
            color: var(--text-primary);
            border-radius: 12px;
            overflow: hidden;
        }

        .table-dark-custom th {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-secondary);
            font-weight: 500;
            border-bottom: 1px solid var(--border-color);
        }

        .table-dark-custom td {
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
        }

        .status-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
            text-align: center;
        }

        .status-incomplete {
            background: rgba(108, 117, 125, 0.15);
            color: #6c757d;
        }

        .status-confirmed {
            background: rgba(40, 167, 69, 0.15);
            color: #28a745;
        }

        .status-balance_pending {
            background: rgba(255, 193, 7, 0.15);
            color: #ffc107;
        }

        .status-balance_overdue {
            background: rgba(220, 53, 69, 0.15);
            color: #dc3545;
        }

        .status-refunded {
            background: rgba(23, 162, 184, 0.15);
            color: #17a2b8;
        }

        .status-replaced {
            background: rgba(134, 115, 161, 0.15);
            color: #8673a1;
        }

        .action-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            padding: 0.4rem;
            transition: all 0.2s;
            border-radius: 6px;
        }

        .action-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--primary-color);
        }

        .action-btn.delete:hover {
            color: var(--danger);
        }

        /* Search Bar */
        .search-container {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .search-input {
            background: var(--bg-base);
            border: 1px solid var(--border);
            color: var(--text-primary);
            padding: 0.5rem 1rem;
            border-radius: 6px;
            min-width: 250px;
        }

        /* Pagination */
        .pagination-container {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .page-link-btn {
            background: var(--surface-light);
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

        .page-link-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--primary-color);
        }

        .page-link-btn.active {
            background: var(--primary-color);
            color: #fff;
            border-color: var(--primary-color);
        }

        /* Modal */
        .custom-modal {
            display: none;
            position: fixed;
            z-index: 10000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.6);
            align-items: center;
            justify-content: center;
        }

        .custom-modal.show {
            display: flex;
        }

        .custom-modal-content {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            width: 90%;
            max-width: 600px;
            padding: 1.5rem;
        }

        .custom-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            padding-bottom: 1rem;
            margin-bottom: 1rem;
        }

        .custom-modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            border-top: 1px solid var(--border);
            padding-top: 1rem;
            margin-top: 1.5rem;
        }

        .close-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-size: 1.5rem;
            cursor: pointer;
        }

        .form-select {
            background: var(--bg-base);
            border: 1px solid var(--border);
            color: var(--text-primary);
            width: 100%;
            padding: 0.5rem;
            border-radius: 6px;
            margin-top: 0.25rem;
            margin-bottom: 1rem;
        }

        .form-label {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        .delete-modal-content {
            background: var(--bg-surface);
            border-radius: 12px;
            width: 90%;
            max-width: 400px;
            padding: 2.5rem 2rem;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border: 1px solid var(--border);
        }

        .delete-modal-content h3 {
            color: var(--text-primary);
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .delete-modal-content p {
            color: var(--text-secondary);
            margin-bottom: 2rem;
            font-size: 0.95rem;
        }

        .delete-modal-actions {
            display: flex;
            justify-content: center;
            gap: 1rem;
        }

        .delete-btn-cancel {
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid var(--border);
            padding: 0.6rem 1.5rem;
            border-radius: 6px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .delete-btn-cancel:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-primary);
        }

        .delete-btn-confirm {
            background: var(--danger);
            color: #fff;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 6px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .delete-btn-confirm:hover {
            opacity: 0.9;
        }
    </style>

    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="sidebar-logo">EZPay2Attend</div>
            <nav>
                <a href="/admin" class="nav-link"><i class="fa-solid fa-chart-line"></i> Dashboard</a>
                <a href="/admin/events" class="nav-link"><i class="fa-solid fa-calendar-alt"></i> Events</a>
                <a href="/admin/schools" class="nav-link"><i class="fa-solid fa-school"></i> Schools</a>
                <a href="/admin/payments" class="nav-link"><i class="fa-solid fa-credit-card"></i> Payments</a>
                <a href="/admin/attendees" class="nav-link active"><i class="fa-solid fa-users"></i> Attendees</a>
                <a href="/admin/refunds" class="nav-link"><i class="fa-solid fa-arrow-rotate-left"></i> Refunds</a>
                <a href="/admin/reports" class="nav-link"><i class="fa-solid fa-file-csv"></i> Reports</a>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <div class="header-left">
                    <h3 style="margin: 0; color: #fff;">Attendee Management</h3>
                </div>

                <div class="header-right">
                    <div class="profile-menu">
                        <div class="profile-icon" onclick="toggleDropdown()"
                            style="border: none; background: transparent; padding: 0;">
                            <div style="text-align: right; margin-right: 0.5rem;">
                                <div style="font-weight: 600; font-size: 0.9rem; color: #fff;">
                                    <%= user.name %>
                                </div>
                                <div style="font-size: 0.75rem; color: var(--text-secondary);">
                                    <%= user.role || 'Admin' %>
                                </div>
                            </div>
                            <i class="fa-solid fa-user-circle" style="font-size: 2rem; color: var(--primary);"></i>
                            <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem; margin-left: 0.5rem;"></i>
                        </div>
                        <div class="profile-dropdown" id="profileDropdown">
                            <div class="dropdown-header">
                                <strong>
                                    <%= user.name %>
                                </strong>
                                <p>
                                    <%= user.email %>
                                </p>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="/admin/profile" class="dropdown-item"><i class="fa-solid fa-user-pen"></i> Edit
                                Profile</a>
                            <a href="javascript:void(0)" onclick="openLogoutModal()"
                                class="dropdown-item text-danger"><i class="fa-solid fa-right-from-bracket"></i>
                                Logout</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h3 style="margin: 0;"><i class="fa-solid fa-users"></i> All Attendees</h3>
                    <div style="display: flex; gap: 1rem; align-items: center;">
                        <a href="/admin/export/attendees" class="btn"
                            style="background: var(--surface-light); border: 1px solid var(--border-color); color: var(--text-secondary); text-decoration: none; padding: 0.5rem 1.5rem; display: flex; align-items: center; gap: 0.5rem; white-space: nowrap;">
                            <i class="fa-solid fa-file-excel" style="color: #4ade80;"></i> Export Excel
                        </a>
                        <!-- <a href="/register" target="_blank" class="btn"
                            style="background: var(--primary); color: #fff; text-decoration: none; padding: 0.5rem 1.5rem; display: flex; align-items: center; gap: 0.5rem; white-space: nowrap;">
                            <i class="fa-solid fa-external-link-alt"></i> Public Registration
                        </a> -->

                        <form class="search-container" method="GET" action="/admin/attendees" style="margin: 0;">
                            <input type="text" class="search-input" name="search" placeholder="Search name or email..."
                                value="<%= search %>">
                            <button type="submit" class="btn"
                                style="width: auto; padding: 0.5rem 1.5rem;">Search</button>
                            <% if(search) { %>
                                <a href="/admin/attendees" class="btn"
                                    style="background: transparent; border: 1px solid var(--border); width: auto;">Clear</a>
                                <% } %>
                        </form>
                    </div>
                </div>

                <div class="entries-control"
                    style="margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: var(--text-secondary);">
                    <span>Show</span>
                    <select class="form-select form-select-sm" onchange="changeEntriesLimit(this.value)"
                        style="width: 70px; display: inline-block; padding: 0.25rem 0.5rem; border-radius: 6px; border: 1px solid var(--border-color); background: var(--surface-light); color: var(--text-primary);">
                        <option value="10" style="color: #000;" <%=pagination.limit===10 ? 'selected' : '' %>>10
                        </option>
                        <option value="20" style="color: #000;" <%=pagination.limit===20 ? 'selected' : '' %>>20
                        </option>
                        <option value="30" style="color: #000;" <%=pagination.limit===30 ? 'selected' : '' %>>30
                        </option>
                        <option value="50" style="color: #000;" <%=pagination.limit===50 ? 'selected' : '' %>>50
                        </option>
                    </select>
                    <span>entries</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark-custom table-hover w-100">
                        <thead>
                            <tr>
                                <th>S.No.</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Contact</th>
                                <th>Event</th>
                                <th>Reg. Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(attendees.length===0) { %>
                                <tr>
                                    <td colspan="8"
                                        style="text-align: center; color: var(--text-secondary); padding: 2rem;">No
                                        attendees found.</td>
                                </tr>
                                <% } else { %>
                                    <% attendees.forEach((attendee, index)=> { %>
                                        <tr>
                                            <td>
                                                <%= (pagination.page - 1) * pagination.limit + index + 1 %>
                                            </td>
                                            <td class="fw-bold">
                                                <%= attendee.fullName %>
                                            </td>
                                            <td>
                                                <%= attendee.email %>
                                            </td>
                                            <td>
                                                <%= attendee.contactNumber %>
                                            </td>
                                            <td>
                                                <%= attendee.event.title %>
                                            </td>
                                            <td>
                                                <%= new Date(attendee.createdAt).toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <% let statusClass='status-incomplete' ;
                                                    if(attendee.status==='CONFIRMED' ) statusClass='status-confirmed' ;
                                                    if(attendee.status==='BALANCE_PENDING' )
                                                    statusClass='status-balance_pending' ;
                                                    if(attendee.status==='BALANCE_OVERDUE' )
                                                    statusClass='status-balance_overdue' ;
                                                    if(attendee.status==='REFUNDED' ||
                                                    attendee.status==='REFUND_REQUESTED' ) statusClass='status-refunded'
                                                    ; if(attendee.status==='REPLACED' ) statusClass='status-replaced' ;
                                                    %>
                                                    <span class="status-badge <%= statusClass %>">
                                                        <%= attendee.status==='REFUND_REQUESTED' ? 'REFUND' :
                                                            attendee.status.replace('_', ' ' ) %>
                                                    </span>
                                            </td>
                                            <td class="text-end" style="white-space: nowrap;">
                                                <button class="action-btn" title="Update Status"
                                                    onclick="openStatusModal('<%= attendee.id %>', '<%= attendee.status %>', '<%= attendee.fullName %>')"><i
                                                        class="fa-solid fa-pen-to-square"></i></button>
                                                <% if (attendee.status==='CONFIRMED' ) { %>
                                                    <button class="action-btn" style="color: #eab308;"
                                                        title="Simulate Refund Request"
                                                        onclick="openRefundModal('<%= attendee.id %>')"><i
                                                            class="fa-solid fa-rotate-left"></i></button>
                                                    <% } %>
                                                        <% if (attendee.status==='BALANCE_PENDING' ||
                                                            attendee.status==='INCOMPLETE' ) { %>
                                                            <button class="action-btn" style="color: #3b82f6;"
                                                                title="Send Reminder"
                                                                onclick="sendIndividualReminder('<%= attendee.id %>', this)"><i
                                                                    class="fa-solid fa-paper-plane"></i></button>
                                                            <% } %>
                                                                <button class="action-btn delete" title="Delete"
                                                                    data-id="<%= attendee.id %>"
                                                                    data-name="<%= attendee.fullName %>"
                                                                    onclick="deleteAttendee(this.dataset.id, this.dataset.name)"><i
                                                                        class="fa-solid fa-trash"></i></button>
                                                                <button class="action-btn text-info" title="View"
                                                                    onclick="viewAttendee('<%= attendee.id %>')"><i
                                                                        class="fa-solid fa-eye"></i></button>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } %>
                        </tbody>
                    </table>
                </div>

                <% if (pagination && pagination.totalPages> 1) { %>
                    <div class="pagination-container">
                        <% if (pagination.page> 1) { %>
                            <a href="?page=<%= pagination.page - 1 %>&search=<%= search %>"
                                class="page-link-btn">Previous</a>
                            <% } %>

                                <% for(let i=1; i<=pagination.totalPages; i++) { %>
                                    <a href="?page=<%= i %>&search=<%= search %>"
                                        class="page-link-btn <%= i === pagination.page ? 'active' : '' %>">
                                        <%= i %>
                                    </a>
                                    <% } %>

                                        <% if (pagination.page < pagination.totalPages) { %>
                                            <a href="?page=<%= pagination.page + 1 %>&search=<%= search %>"
                                                class="page-link-btn">Next</a>
                                            <% } %>
                    </div>
                    <% } %>
            </div>
        </main>
    </div>

    <!-- Update Status Modal -->
    <div class="custom-modal" id="updateStatusModal">
        <div class="custom-modal-content">
            <div class="custom-modal-header">
                <h3 style="margin: 0; color: var(--text-primary);">Update Status</h3>
                <button type="button" class="close-btn" onclick="closeStatusModal()">&times;</button>
            </div>
            <form id="updateStatusForm">
                <p style="color: var(--text-secondary); margin-bottom: 1rem;">Update status for: <strong
                        id="statusAttendeeName" style="color: #fff;"></strong></p>
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status" id="statusSelect" required>
                        <option value="INCOMPLETE">Incomplete</option>
                        <option value="CONFIRMED">Confirmed</option>
                        <option value="BALANCE_PENDING">Balance Pending</option>
                        <option value="BALANCE_OVERDUE">Balance Overdue</option>
                        <option value="REFUNDED">Refunded</option>
                        <option value="REPLACED">Replaced</option>
                    </select>
                </div>
                <div class="custom-modal-footer">
                    <button type="button" class="btn"
                        style="background: transparent; color: var(--text-secondary); width: auto;"
                        onclick="closeStatusModal()">Cancel</button>
                    <button type="button" class="btn" style="width: auto;" id="saveStatusBtn"
                        onclick="saveStatusData()">Save Status</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="custom-modal" id="deleteAttendeeModal">
        <div class="delete-modal-content">
            <h3>Confirm Delete</h3>
            <p>Are you sure you want to delete <span id="deleteAttendeeName"
                    style="font-weight: 700; color: var(--text-primary);"></span>?</p>
            <div class="delete-modal-actions">
                <button type="button" class="delete-btn-cancel" onclick="closeDeleteModal()">Cancel</button>
                <button type="button" class="delete-btn-confirm" onclick="confirmDeleteAttendee()">Delete</button>
            </div>
        </div>
    </div>

    <!-- View Attendee Modal -->
    <div class="custom-modal" id="viewAttendeeModal">
        <div class="custom-modal-content">
            <div class="custom-modal-header">
                <h3 style="margin: 0; color: var(--text-primary);">Attendee Details</h3>
                <button type="button" class="close-btn" onclick="closeViewModal()">&times;</button>
            </div>
            <div id="viewAttendeeDetails" style="color: var(--text-secondary); line-height: 1.6; font-size: 0.95rem;">
                <!-- Content injected via JS -->
            </div>
        </div>
    </div>
    <!-- Refund Confirmation Modal -->
    <div class="custom-modal" id="refundAttendeeModal">
        <div class="delete-modal-content">
            <h3>Simulate Refund</h3>
            <p>Are you sure you want to simulate a refund request for this attendee?</p>
            <div class="delete-modal-actions">
                <button type="button" class="delete-btn-cancel" onclick="closeRefundModal()">Cancel</button>
                <button type="button" class="delete-btn-confirm" style="background: #4f46e5;"
                    onclick="confirmRefundAttendee()">Simulate</button>
            </div>
        </div>
    </div>


    <script id="attendeesData" type="application/json">
    <%- JSON.stringify(attendees || []) %>
    </script>

    <script>
        const allAttendees = JSON.parse(document.getElementById('attendeesData').textContent);
        let activeAttendeeId = null;
        let refundAttendeeId = null;

        function viewAttendee(id) {
            const attendee = allAttendees.find(a => a.id === id);
            if (!attendee) return;

            let paymentDetailsHtml = '';
            if (attendee.payments && attendee.payments.length > 0) {
                paymentDetailsHtml = `
                    <div class="col-md-12" style="margin-top: 1rem;">
                        <h5 style="color: #fff; margin-bottom: 0.5rem; font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">Payment Details</h5>
                        <ul style="list-style-type: none; padding-left: 0;">
                            ${attendee.payments.map(p => `
                                <li style="margin-bottom: 0.5rem; background: rgba(255,255,255,0.05); padding: 0.5rem; border-radius: 6px;">
                                    <strong>Type:</strong> ${p.type} | 
                                    <strong>Amount:</strong> $${p.amount} | 
                                    <strong>Status:</strong> ${p.status}
                                </li>
                            `).join('')}
                        </ul>
                    </div>
                `;
            } else {
                paymentDetailsHtml = `
                    <div class="col-md-12" style="margin-top: 1rem;">
                        <h5 style="color: #fff; margin-bottom: 0.5rem; font-size: 1.1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">Payment Details</h5>
                        <p>No payments recorded yet.</p>
                    </div>
                 `;
            }

            let totalPaid = 0;
            if (attendee.payments && attendee.payments.length > 0) {
                attendee.payments.forEach(p => {
                    if (p.status === 'SUCCESS' && p.type !== 'REFUND') totalPaid += parseFloat(p.amount) || 0;
                });
            }
            let cost = attendee.event ? parseFloat(attendee.event.costPerAttendee) || 0 : 0;
            let balanceDue = cost - totalPaid;
            if (balanceDue < 0) balanceDue = 0;

            const detailsHtml = `
                <div class="row">
                    <div class="col-md-12" style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem; display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <h4 style="color: #fff; margin-bottom: 0.5rem; font-size: 1.3rem;">${attendee.fullName}</h4>
                            <span class="status-badge status-${attendee.status === 'REFUND_REQUESTED' ? 'refunded' : attendee.status.toLowerCase()}">${attendee.status === 'REFUND_REQUESTED' ? 'REFUND' : attendee.status.replace('_', ' ')}</span>
                        </div>
                        <div style="text-align: right; background: rgba(255,255,255,0.05); padding: 0.6rem 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
                            <div style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 0.3rem;">Total Amount: <strong style="color: #fff; font-size: 1rem;">$${cost.toFixed(2)}</strong></div>
                            ${balanceDue > 0 ? `<div style="color: #f59e0b; font-size: 0.9rem;">Pending: <strong style="font-size: 1rem;">$${balanceDue.toFixed(2)}</strong></div>` : `<div style="color: #10b981; font-size: 0.9rem;"><i class="fa-solid fa-check-circle"></i> Fully Paid</div>`}
                        </div>
                    </div>
                    <div class="col-md-6" style="margin-bottom: 0.8rem;"><strong>Email:</strong> ${attendee.email}</div>
                    <div class="col-md-6" style="margin-bottom: 0.8rem;"><strong>Contact:</strong> ${attendee.contactNumber}</div>
                    <div class="col-md-6" style="margin-bottom: 0.8rem;"><strong>Event:</strong> ${attendee.event ? attendee.event.title : 'N/A'}</div>
                    <div class="col-md-6" style="margin-bottom: 0.8rem;"><strong>Reg. Date:</strong> ${new Date(attendee.createdAt).toLocaleDateString()}</div>
                    ${paymentDetailsHtml}
                </div>
            `;
            document.getElementById('viewAttendeeDetails').innerHTML = detailsHtml;
            document.getElementById('viewAttendeeModal').classList.add('show');
        }

        function closeViewModal() {
            document.getElementById('viewAttendeeModal').classList.remove('show');
        }

        function openStatusModal(id, currentStatus, name) {
            activeAttendeeId = id;
            document.getElementById('statusAttendeeName').textContent = name;
            document.getElementById('statusSelect').value = currentStatus;
            document.getElementById('updateStatusModal').classList.add('show');
        }

        function closeStatusModal() {
            activeAttendeeId = null;
            document.getElementById('updateStatusModal').classList.remove('show');
        }

        async function saveStatusData() {
            if (!activeAttendeeId) return;
            const status = document.getElementById('statusSelect').value;
            const btn = document.getElementById('saveStatusBtn');
            btn.disabled = true;
            btn.innerHTML = 'Saving...';

            try {
                const res = await fetch('/api/attendees/' + activeAttendeeId + '/status', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status })
                });
                const result = await res.json();

                if (result.success) {
                    showToast(result.message, 'success');
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast(result.message, 'error');
                    btn.disabled = false;
                    btn.innerHTML = 'Save Status';
                }
            } catch (err) {
                showToast('Network error occurred.', 'error');
                btn.disabled = false;
                btn.innerHTML = 'Save Status';
            }
        }

        let attendeeToDelete = null;

        function deleteAttendee(id, name) {
            attendeeToDelete = id;
            document.getElementById('deleteAttendeeName').textContent = name;
            document.getElementById('deleteAttendeeModal').classList.add('show');
        }

        function closeDeleteModal() {
            attendeeToDelete = null;
            document.getElementById('deleteAttendeeModal').classList.remove('show');
        }

        async function confirmDeleteAttendee() {
            if (!attendeeToDelete) return;

            try {
                const res = await fetch('/api/attendees/' + attendeeToDelete, { method: 'DELETE' });
                const result = await res.json();
                if (result.success) {
                    showToast(result.message, 'success');
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast('Error: ' + result.message, 'error');
                    closeDeleteModal();
                }
            } catch (err) {
                showToast('Network error occurred.', 'error');
                closeDeleteModal();
            }
        }

        function toggleDropdown() {
            document.getElementById("profileDropdown").classList.toggle("show");
        }

        window.onclick = function (event) {
            if (!event.target.closest('.profile-menu')) {
                var dropdowns = document.getElementsByClassName("profile-dropdown");
                for (var i = 0; i < dropdowns.length; i++) {
                    var openDropdown = dropdowns[i];
                    if (openDropdown.classList.contains('show')) {
                        openDropdown.classList.remove('show');
                    }
                }
            }
        }

        async function sendIndividualReminder(id, btn) {
            const originalIcon = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
            btn.disabled = true;

            try {
                const res = await fetch(`/api/attendees/${id}/reminders/balance`, { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    showToast(result.message, 'success');
                } else {
                    showToast('Error: ' + result.message, 'error');
                }
            } catch (err) {
                showToast('Failed to send reminder.', 'error');
            } finally {
                btn.innerHTML = originalIcon;
                btn.disabled = false;
            }
        }
        function openRefundModal(id) {
            refundAttendeeId = id;
            document.getElementById('refundAttendeeModal').classList.add('show');
        }

        function closeRefundModal() {
            refundAttendeeId = null;
            document.getElementById('refundAttendeeModal').classList.remove('show');
        }

        async function confirmRefundAttendee() {
            if (!refundAttendeeId) return;
            const btn = document.querySelector('#refundAttendeeModal .delete-btn-confirm');
            const originalText = btn.innerHTML;
            btn.innerHTML = 'Wait...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/attendees/' + refundAttendeeId + '/request-refund', { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    showToast(result.message, 'success');
                    closeRefundModal();
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast('Error: ' + result.message, 'error');
                }
            } catch (err) {
                showToast('Failed to request refund.', 'error');
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }
    </script>
    </body>

    </html>