<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'EZPay2Attend Admin' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script>
        function showToast(message, type = 'success') {
            Toastify({
                text: message,
                duration: 3000,
                close: true,
                gravity: "top", 
                position: "right",
                style: {
                    background: type === 'success' ? "linear-gradient(to right, #00b09b, #96c93d)" : "linear-gradient(to right, #ff5f6d, #ffc371)",
                    borderRadius: "8px",
                    fontFamily: "Inter, sans-serif"
                }
            }).showToast();
        }
    </script>
</head>
<body>
<!-- Global Logout Modal -->
<style>
    .global-modal {
        display: none; position: fixed; z-index: 100000; left: 0; top: 0; width: 100%; height: 100%;
        background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center;
    }
    .global-modal.show { display: flex; }
    .global-modal-content {
        background: #fff; border-radius: 12px; width: 90%; max-width: 400px;
        padding: 2.5rem 2rem; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.5); font-family: 'Inter', sans-serif;
    }
    .global-modal-content h3 { color: #1E293B; font-weight: 700; margin-top: 0; margin-bottom: 0.5rem; font-size: 1.5rem; }
    .global-modal-content p { color: #475569; margin-bottom: 2rem; font-size: 0.95rem; }
    .global-modal-actions { display: flex; justify-content: center; gap: 1rem; }
    .global-btn-cancel { background: #fff; color: #1E293B; border: 1px solid #CBD5E1; padding: 0.6rem 1.5rem; border-radius: 6px; font-weight: 500; cursor: pointer; transition: 0.2s; }
    .global-btn-cancel:hover { background: #f1f5f9; }
    .global-btn-confirm { background: #1E293B; color: #fff; border: none; padding: 0.6rem 1.5rem; border-radius: 6px; font-weight: 500; cursor: pointer; transition: 0.2s; }
    .global-btn-confirm:hover { background: #0f172a; }
</style>
<div class="global-modal" id="globalLogoutModal">
    <div class="global-modal-content">
        <h3>Confirm Logout</h3>
        <p>Are you sure you want to log out of your session?</p>
        <div class="global-modal-actions">
            <button class="global-btn-cancel" onclick="closeLogoutModal()">Cancel</button>
            <button class="global-btn-confirm" onclick="confirmLogout()">Logout</button>
        </div>
    </div>
</div>
<script>
    function openLogoutModal() {
        document.getElementById('globalLogoutModal').classList.add('show');
    }
    function closeLogoutModal() {
        document.getElementById('globalLogoutModal').classList.remove('show');
    }
    function confirmLogout() {
        window.location.href = '/api/auth/logout';
    }

    // Handle BFCache (Back-Forward Cache) to prevent showing protected pages
    // after logout when using browser back button
    window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
            window.location.reload();
        }
    });
</script>
