{
    "info": {
        "name": "EZPay2Attend Phase 1 API",
        "description": "API collection for EZPay2Attend",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "url": {"raw": "http://localhost:5000/api/auth/login", "host": ["http://localhost:5000"], "path": ["api", "auth", "login"]},
                        "body": {"mode": "raw", "raw": "{\"email\":\"superadmin@ezpay2attend.com\",\"password\":\"Root@123\"}"}
                    }
                }
            ]
        },
        {
            "name": "Schools",
            "item": [
                {
                    "name": "Create School",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "url": {"raw": "http://localhost:5000/api/schools", "host": ["http://localhost:5000"], "path": ["api", "schools"]}
                    }
                }
            ]
        },
        {
            "name": "Events",
            "item": [
                {
                    "name": "Create Event",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "url": {"raw": "http://localhost:5000/api/events", "host": ["http://localhost:5000"], "path": ["api", "events"]}
                    }
                }
            ]
        },
        {
            "name": "Attendees",
            "item": [
                {
                    "name": "Public Registration",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "url": {"raw": "http://localhost:5000/api/attendees/register", "host": ["http://localhost:5000"], "path": ["api", "attendees", "register"]},
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"eventId\": \"REPLACE_WITH_EVENT_ID\",\n  \"fullName\": \"Jane Doe\",\n  \"guardianName\": \"John Doe\",\n  \"contactNumber\": \"+1 555-0199\",\n  \"email\": \"jane.doe@example.com\"\n}"
                        }
                    }
                },
                {
                    "name": "Get All Attendees",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "url": {"raw": "http://localhost:5000/api/attendees", "host": ["http://localhost:5000"], "path": ["api", "attendees"]}
                    }
                },
                {
                    "name": "Update Attendee Status",
                    "request": {
                        "method": "PATCH",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "url": {"raw": "http://localhost:5000/api/attendees/REPLACE_WITH_ATTENDEE_ID/status", "host": ["http://localhost:5000"], "path": ["api", "attendees", "REPLACE_WITH_ATTENDEE_ID", "status"]},
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
                        }
                    }
                },
                {
                    "name": "Delete Attendee",
                    "request": {
                        "method": "DELETE",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "url": {"raw": "http://localhost:5000/api/attendees/REPLACE_WITH_ATTENDEE_ID", "host": ["http://localhost:5000"], "path": ["api", "attendees", "REPLACE_WITH_ATTENDEE_ID"]}
                    }
                },
                {
                    "name": "Get Refund Queue",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "url": {
                            "raw": "http://localhost:5000/api/attendees?status=REFUNDED",
                            "host": ["http://localhost:5000"],
                            "path": ["api", "attendees"],
                            "query": [{"key": "status", "value": "REFUNDED"}]
                        }
                    }
                }
            ]
        },
        {
            "name": "Payments",
            "item": [
                {
                    "name": "Webhook (Mock)",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "url": {"raw": "http://localhost:5000/api/payments/webhook", "host": ["http://localhost:5000"], "path": ["api", "payments", "webhook"]}
                    }
                },
                {
                    "name": "Payment History",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "url": {"raw": "http://localhost:5000/api/payments", "host": ["http://localhost:5000"], "path": ["api", "payments"]}
                    }
                }
            ]
        }
    ]
}
